# Local run: cp .env.example .env && docker compose up --build
# The prod stack uses its own file: prod/.env.example
COMPOSE_PROJECT_NAME=sim112-local
DB_PASSWORD=postgres
FRONTEND_BASE_URL=http://localhost:4321
APP_BASE_URL=http://localhost:4321

# notification-service - Gmail SMTP app password: https://myaccount.google.com/apppasswords
# Optional: without it emails (verification, password reset) are not sent; see README for
# confirming the first account by hand.
MAIL_USERNAME=
MAIL_PASSWORD=

# AI models run on the host, see "Локальный запуск" in README.md.
# host.docker.internal = the machine running docker compose.
TTS_SERVER_TAILSCALE_HOST=host.docker.internal
OLLAMA_SERVER_TAILSCALE_HOST=host.docker.internal

# dialog-service / review-service: OpenAI-compatible API of the local Ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3-dialog:4b

# review-service: NLI model from review-model-server (mlserver start, port 8080)
MLSERVER_URL=http://host.docker.internal:8080
MLSERVER_MODEL_NAME=review-model

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Optional map / address suggestions
DGIS_MAPGL_KEY=
PUBLIC_DADATA_API_KEY=

# Optional (defaults in docker-compose.yml)
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_REPLENISH=200
RATE_LIMIT_BURST=400
