---
import LogoutButton from "../features/auth/components/LogoutButton.astro";

const role = Astro.cookies.get("role")?.value;
const isAdmin = role === "ADMIN";
const isTeacher = role === "SUPERVISOR";
const isStudent = role === "STUDENT";
const canManageTraining = isAdmin || isTeacher;
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? pathname === href : pathname.startsWith(href);
const profile = Astro.locals.profile;
const initials = profile ? `${profile.name?.[0] || ""}${(profile.patronymic || profile.surname)?.[0] || ""}`.toUpperCase() : "";
---

<header slot="header">
  <div class="header-layout">
    <a class="header-brand" href="/" aria-label="На главную">
      <img src="/assets/simulator-logo.svg" alt="" />
    </a>
    <div class="wa-split">
      <div class="wa-cluster">
        {isStudent && (
          <div class="wa-cluster">
            <wa-button class:list={{ 'header-nav-active': isActive('/') }} appearance="plain" variant="neutral" href="/" aria-current={isActive('/') ? 'page' : undefined}>Мои курсы</wa-button>
            <wa-button class:list={{ 'header-nav-active': isActive('/map') }} appearance="plain" variant="neutral" href="/map" aria-current={isActive('/map') ? 'page' : undefined}>Карта</wa-button>
          </div>
        )}
        {canManageTraining && (
          <nav class="wa-cluster wa-gap-xs" aria-label="Разделы преподавателя">
            <wa-button class:list={{ 'header-nav-active': isActive('/teacher/courses') }} appearance="plain" variant="brand" href="/teacher/courses" aria-current={isActive('/teacher/courses') ? 'page' : undefined}>Курсы</wa-button>
            <wa-button class:list={{ 'header-nav-active': isActive('/teacher/groups') }} appearance="plain" variant="brand" href="/teacher/groups" aria-current={isActive('/teacher/groups') ? 'page' : undefined}>Группы</wa-button>
            <wa-button class:list={{ 'header-nav-active': isActive('/teacher/assignments') }} appearance="plain" variant="brand" href="/teacher/assignments" aria-current={isActive('/teacher/assignments') ? 'page' : undefined}>Назначение курсов</wa-button>
            <wa-button class:list={{ 'header-nav-active': isActive('/admin/incidents') }} appearance="plain" variant="brand" href="/admin/incidents" aria-current={isActive('/admin/incidents') ? 'page' : undefined}>Сценарии</wa-button>
            {isAdmin && <wa-button class:list={{ 'header-nav-active': isActive('/admin/users') }} appearance="plain" variant="brand" href="/admin/users" aria-current={isActive('/admin/users') ? 'page' : undefined}>Пользователи</wa-button>}
          </nav>
        )}
      </div>
      <div class="profile-menu-wrap">
        <wa-button id="profile-menu-trigger" class:list={{ 'header-nav-active': isActive('/profile') }} appearance="plain" variant="neutral" aria-label="Открыть меню профиля">
          <wa-avatar slot="start" initials={initials} label="Аватар пользователя">
          </wa-avatar>
          <span class="profile-menu-name">Профиль
          </span>
          <wa-icon slot="end" name="chevron-down" aria-hidden="true">
          </wa-icon>
        </wa-button>
        <wa-popover class="profile-menu-popover" for="profile-menu-trigger" placement="bottom-end" without-arrow>
          <nav class="profile-menu wa-stack wa-gap-3xs" aria-label="Меню пользователя">
            <wa-button appearance="plain" variant="neutral" href="/profile" data-popover="close">
              <wa-icon slot="start" name="chart-line">
              </wa-icon>
              Статистика
            </wa-button>
            <wa-button id="notifications-menu-item" appearance="plain" variant="neutral" data-popover="close">
              <wa-icon slot="start" name="bell">
              </wa-icon>
              Уведомления
              <wa-badge id="notification-unread-badge" slot="end" variant="danger" pill hidden>0</wa-badge>
            </wa-button>
            <wa-button appearance="plain" variant="neutral" href="/profile/settings" data-popover="close">
              <wa-icon slot="start" name="user-gear">
              </wa-icon>
              Настройки профиля
            </wa-button>
            <wa-divider>
            </wa-divider>
            <LogoutButton />
          </nav>
        </wa-popover>
        <span id="notifications-anchor" class="notifications-anchor" aria-hidden="true"></span>
        <wa-popover id="notifications-popover" class="notifications-popover" for="notifications-anchor" placement="bottom-end" without-arrow>
          <div class="notifications-panel wa-stack wa-gap-2xs">
            <div class="notifications-panel-header">
              <span class="wa-heading-s">Уведомления</span>
              <wa-button id="notifications-mark-all" appearance="plain" variant="neutral" size="small">
                Прочитать всё
              </wa-button>
            </div>
            <wa-divider>
            </wa-divider>
            <div id="notifications-list" class="notifications-list wa-stack wa-gap-2xs" aria-live="polite">
              <div class="notifications-status">Загрузка…</div>
            </div>
          </div>
        </wa-popover>
      </div>
    </div>
  </div>
</header>

<script>
  const menuItem = document.querySelector('#notifications-menu-item');
  const badge = document.querySelector('#notification-unread-badge');
  const popover = document.querySelector('#notifications-popover');
  const list = document.querySelector('#notifications-list');
  const markAllButton = document.querySelector('#notifications-mark-all');

  const dateFormatter = new Intl.DateTimeFormat('ru-RU', { dateStyle: 'medium', timeStyle: 'short' });
  let unreadCount = 0;

  function setUnreadCount(count) {
    unreadCount = Math.max(0, count);
    if (!badge) return;
    if (unreadCount > 0) {
      badge.textContent = unreadCount > 99 ? '99+' : String(unreadCount);
      badge.hidden = false;
    } else {
      badge.hidden = true;
    }
  }

  async function refreshUnreadCount() {
    try {
      const response = await fetch('/api/v1/notifications/unread-count');
      if (!response.ok) return;
      const data = await response.json();
      setUnreadCount(data.unreadCount ?? 0);
    } catch {
      // notification-service недоступен — меню продолжает работать без счётчика
    }
  }

  function renderNotifications(notifications) {
    if (!list) return;
    list.innerHTML = '';
    if (!notifications.length) {
      list.innerHTML = '<div class="notifications-status">Уведомлений пока нет</div>';
      return;
    }
    for (const notification of notifications) {
      const item = document.createElement('a');
      item.href = notification.targetUrl || '#';
      item.className = notification.read ? 'notification-item' : 'notification-item is-unread';
      const created = notification.createdAt ? dateFormatter.format(new Date(notification.createdAt)) : '';
      const title = document.createElement('strong');
      title.textContent = notification.title;
      const time = document.createElement('time');
      time.textContent = created;
      const header = document.createElement('div');
      header.className = 'notification-item-header';
      header.append(title, time);
      const text = document.createElement('p');
      text.textContent = notification.text;
      item.append(header, text);
      item.addEventListener('click', () => {
        if (notification.read) return;
        notification.read = true;
        item.classList.remove('is-unread');
        setUnreadCount(unreadCount - 1);
        fetch(`/api/v1/notifications/${notification.id}/read`, { method: 'PATCH', keepalive: true }).catch(() => {});
      });
      list.appendChild(item);
    }
  }

  async function loadNotifications() {
    if (!list) return;
    list.innerHTML = '<div class="notifications-status">Загрузка…</div>';
    try {
      const response = await fetch('/api/v1/notifications');
      if (!response.ok) {
        list.innerHTML = '<div class="notifications-status">Не удалось загрузить уведомления</div>';
        return;
      }
      const data = await response.json();
      renderNotifications(data.notifications || []);
    } catch {
      list.innerHTML = '<div class="notifications-status">Не удалось загрузить уведомления</div>';
    }
  }

  menuItem?.addEventListener('click', () => {
    popover?.show?.();
    loadNotifications();
  });

  markAllButton?.addEventListener('click', async () => {
    markAllButton.loading = true;
    try {
      const response = await fetch('/api/v1/notifications/read-all', { method: 'PATCH' });
      if (response.ok) {
        list?.querySelectorAll('.notification-item.is-unread').forEach((el) => el.classList.remove('is-unread'));
        setUnreadCount(0);
      }
    } catch {
      // счётчик обновится при следующем открытии
    } finally {
      markAllButton.loading = false;
    }
  });

  refreshUnreadCount();
</script>

<style>
  .profile-menu-wrap { position: relative; flex: 0 0 auto; }
  .notifications-anchor { position: absolute; inset: 0; pointer-events: none; }
  #profile-menu-trigger wa-avatar { --size: 2rem; --wa-color-neutral-fill-normal: var(--wa-color-neutral-90); --wa-color-neutral-on-normal: var(--wa-color-neutral-05); font-weight: var(--wa-font-weight-bold); }
  .profile-menu-popover { --max-width: 18rem; color: var(--wa-color-text-normal); }
  .profile-menu-popover::part(body) { padding: var(--wa-space-2xs); }
  .profile-menu { box-sizing: border-box; inline-size: 14rem; }
  .profile-menu wa-button { box-sizing: border-box; width: 100%; margin-inline-start: 0; --wa-color-neutral-on-quiet: var(--wa-color-text-normal); }
  .profile-menu wa-button::part(button) { justify-content: flex-start; }
  .profile-menu wa-button[variant='neutral']::part(button):hover { background: var(--wa-color-neutral-fill-normal); color: var(--wa-color-text-normal); }

  #notifications-menu-item::part(button) { position: relative; }
  #notification-unread-badge { margin-inline-start: auto; }

  .notifications-popover { --max-width: 24rem; color: var(--wa-color-text-normal); }
  .notifications-popover::part(body) { padding: 0; }
  .notifications-panel { box-sizing: border-box; inline-size: 22rem; max-block-size: 28rem; }
  .notifications-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--wa-space-s);
    padding: var(--wa-space-s) var(--wa-space-m);
  }
  .notifications-panel-header .wa-heading-s { margin: 0; }
  .notifications-list { overflow-y: auto; padding: var(--wa-space-2xs) var(--wa-space-2xs) var(--wa-space-s); }
  .notifications-status { padding: var(--wa-space-l) var(--wa-space-m); color: var(--wa-color-text-quiet); text-align: center; }

  .notification-item {
    display: block;
    box-sizing: border-box;
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    border-inline-start-width: var(--wa-space-3xs);
    background: var(--wa-color-surface-raised);
    color: inherit;
    text-decoration: none;
  }
  .notification-item + .notification-item { margin-block-start: var(--wa-space-2xs); }
  .notification-item:hover { background: var(--wa-color-neutral-fill-quiet); }
  .notification-item.is-unread { border-inline-start-color: var(--wa-color-brand-fill-loud); background: var(--wa-color-brand-fill-quiet); }

  .notification-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--wa-space-m);
    padding: var(--wa-space-2xs) var(--wa-space-s) 0;
  }
  .notification-item-header strong { font-size: var(--wa-font-size-s); }
  .notification-item-header time { flex: 0 0 auto; color: var(--wa-color-text-quiet); font-size: var(--wa-font-size-2xs); }

  .notification-item p {
    margin: 0;
    padding: var(--wa-space-2xs) var(--wa-space-s) var(--wa-space-s);
    font-size: var(--wa-font-size-s);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
