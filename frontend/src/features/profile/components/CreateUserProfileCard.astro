---
import DispatchServiceOptions from "../../incident/components/DispatchServiceOptions.astro";
const error =  Astro.url.searchParams.get("error");
const role = Astro.cookies.get("role")?.value;
const isAdmin = role === "ADMIN";
const profileRequired = role === "STUDENT";
---
<wa-card style="width: 100%; max-width: 30rem" class="card-header">
  <h2 slot="header">
    Создание профиля
  </h2>
  <form method="POST" action="/api/v1/profile">
    <div class="wa-stack">
      <wa-input name="name" label="Имя" required>
      </wa-input>
      <wa-input name="patronymic" label="Отчество">
      </wa-input>
      <wa-input name="surname" label="Фамилия" required>
      </wa-input>
      {!isAdmin && (
        <>
          <wa-select name="trainingTrack" label={profileRequired ? "Профиль" : "Профиль (необязательно)"} placeholder="Выберите профиль" required={profileRequired}>
            <wa-option value="SYSTEM_112">Система-112</wa-option>
            <wa-option value="DDS">ДДС</wa-option>
          </wa-select>
          <div id="dds-service-field" hidden>
            <wa-select name="ddsService" label="Служба ДДС" placeholder="Выберите службу" disabled>
              <DispatchServiceOptions />
            </wa-select>
          </div>
        </>
      )}
      <wa-button type="submit" variant="success">
        Сохранить профиль
      </wa-button>
      {error && (
        <wa-callout class="wa-danger">
          <wa-icon slot="icon" name="circle-exclamation">
          </wa-icon>
          <strong>
            {error}
          </strong>
        </wa-callout>
      )}
    </div>
  </form>
</wa-card>

<script>
  const trainingTrack = document.querySelector<HTMLInputElement>("wa-select[name='trainingTrack']");
  const ddsServiceField = document.querySelector<HTMLElement>("#dds-service-field");
  const ddsService = document.querySelector<HTMLElement>("wa-select[name='ddsService']");

  const updateDdsServiceField = () => {
    const isDds = trainingTrack?.value === "DDS";
    ddsServiceField?.toggleAttribute("hidden", !isDds);
    ddsService?.toggleAttribute("disabled", !isDds);
    ddsService?.toggleAttribute("required", isDds);
  };

  trainingTrack?.addEventListener("change", updateDdsServiceField);
  updateDdsServiceField();
</script>
