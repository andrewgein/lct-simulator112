---
import IncidentStagesEditor from "./IncidentStagesEditor.jsx";

/** @typedef {import("../../contract/Incident").IncidentStage} IncidentStage */
/** @type {{ stages?: IncidentStage[] }} */
const { stages = [] } = Astro.props;
---
<IncidentStagesEditor initialStages={stages} client:load />
<style is:global>
  #incident-form .hint { margin: var(--wa-space-2xs) 0 0; color: var(--wa-color-text-quiet); }
  #incident-stages .dialup-meta { color: var(--wa-color-text-quiet); }
  #incident-stages .dialup-error { color: var(--wa-color-danger-60); margin: 0; }
  #incident-stages .dialog-section { flex: 1 1 0; min-inline-size: 0; }
  #incident-stages .dialog-divider-desktop { align-self: stretch; height: auto; }
  #incident-stages .dialog-divider-mobile { display: none; }
  #incident-stages .dialup-basics { --min-column-size: 12rem; }
  @media (max-width: 70rem) {
    #incident-stages .dialog-section { flex-basis: 100%; }
    #incident-stages .dialog-divider-desktop { display: none; }
    #incident-stages .dialog-divider-mobile { display: block; flex-basis: 100%; }
  }
</style>
