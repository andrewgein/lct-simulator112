---
/** @typedef {import("../../contract/Incident").Incident} Incident */
/** @type {{ incident: Incident, canDelete?: boolean }} */
const { incident, canDelete = true } = Astro.props;
const isDds = incident.targetType === "DDS";
const editHref = isDds ? `/admin/incidents/dds/${incident.id}` : `/admin/incidents/${incident.id}`;
---

<wa-card>
  <div class="wa-split wa-align-items-center">
    <div class="wa-stack wa-gap-2xs">
      <strong class="wa-heading-l">
        {incident.title}
      </strong>
      <div class="wa-cluster wa-gap-xs">
        <wa-badge variant={isDds ? "warning" : "brand"}>{isDds ? "ДДС" : "Система-112"}</wa-badge>
        <span>{isDds ? `${incident.stages?.length || 0} этапов` : incident.stages?.[0]?.type?.typeName}</span>
      </div>
    </div>
    <div class="wa-cluster">
      <slot name="actions">
        <wa-button href={editHref} appearance="outlined" aria-label={`Редактировать сценарий ${incident.title}`}>
          <wa-icon name="pen"></wa-icon>
        </wa-button>
        {canDelete && (
          <wa-button class="delete-incident" data-id={incident.id} appearance="outlined" variant="danger">
            <wa-icon name="trash"></wa-icon>
          </wa-button>
        )}
      </slot>
    </div>
  </div>
</wa-card>
