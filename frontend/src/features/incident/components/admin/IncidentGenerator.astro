<div id="incident-generator" class="generator-panel">
  <div class="generator-heading">
    <div class="generator-title"><wa-icon name="wand-magic-sparkles" aria-hidden="true"></wa-icon><h2>ИИ-конструктор</h2></div>
    <wa-button id="close-incident-generator" type="button" appearance="plain" aria-label="Закрыть ИИ-конструктор"><wa-icon name="xmark" aria-hidden="true"></wa-icon></wa-button>
  </div>
  <div class="generator-body">
    <div id="generator-messages" role="log" aria-live="polite" aria-label="История чата"><p class="generator-message generator-message--assistant">Опишите происшествие или попросите изменить детали сценария.</p></div>
    <form id="generator-chat" class="generator-compose">
      <wa-textarea id="generator-prompt" aria-label="Ваш запрос" placeholder="Напишите запрос" rows="2" resize="none" maxlength="4000"></wa-textarea>
      <wa-button id="generator-send" type="submit" variant="brand" size="l" aria-label="Отправить запрос"><wa-icon name="paper-plane" aria-hidden="true"></wa-icon></wa-button>
    </form>
  </div>
</div>
<script>
  const form = document.querySelector('#incident-form');
  const page = document.querySelector('wa-page');
  const generator = document.querySelector('#incident-generator');
  const chat = document.querySelector('#generator-chat');
  const prompt = document.querySelector('#generator-prompt');
  const send = document.querySelector('#generator-send');
  const log = document.querySelector('#generator-messages');
  const messages = [];

  const toggle = document.querySelector('#open-incident-generator');
  const setOpen = (open) => {
    page.classList.toggle('generator-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Закрыть ИИ-чат' : 'Открыть ИИ-чат');
    if (open) prompt.focus();
    else toggle.focus();
  };
  toggle?.addEventListener('click', () => setOpen(!page.classList.contains('generator-open')));
  document.querySelector('#close-incident-generator')?.addEventListener('click', () => setOpen(false));
  const appendMessage = (role, text) => {
    const item = document.createElement('p');
    item.className = `generator-message generator-message--${role}`;
    item.textContent = text;
    if (role === 'error') item.setAttribute('role', 'alert');
    log.append(item);
    log.scrollTop = log.scrollHeight;
  };
  const collectDraft = () => {
    if (!form.getIncidentStages) throw new Error('Подождите, пока загрузится редактор этапов');
    const data = Object.fromEntries(new FormData(form));
    const detail = { criteria: [] };
    form.dispatchEvent(new CustomEvent('collect-dialogue-criteria', { detail }));
    return {
      title: data.title || '',
      difficulty: data.difficulty || 'NORMAL',
      address: {
        city: data['address.city'] || '', street: data['address.street'] || '', house: data['address.house'] || '',
        building: data['address.building'] || null, apartment: data['address.apartment'] || null,
        floor: data['address.floor'] === '' ? null : Number(data['address.floor'] || 0)
      },
      stages: form.getIncidentStages(), dialogueCriteria: detail.criteria
    };
  };
  const applyIncident = (incident) => {
    if (!incident || typeof incident !== 'object' || Array.isArray(incident)) throw new Error('Модель вернула некорректное изменение сценария');
    const applyStages = Object.hasOwn(incident, 'stages') ? form.prepareGeneratedStages(incident.stages) : null;
    const fields = { ...Object.fromEntries(['title', 'difficulty'].filter((name) => Object.hasOwn(incident, name)).map((name) => [name, incident[name]])),
      ...Object.fromEntries(Object.entries(incident.address || {}).map(([part, value]) => [`address.${part}`, value])) };
    for (const [name, value] of Object.entries(fields)) {
      const field = form.querySelector(`[name="${name}"]`);
      if (field) field.value = value == null ? '' : String(value);
    }
    if (incident.address) {
      const address = collectDraft().address;
      const fullAddress = [address.city, address.street, address.house && `д. ${address.house}`, address.building && `корп. ${address.building}`, address.apartment && `кв. ${address.apartment}`].filter(Boolean).join(', ');
      const addressInput = form.querySelector('#incident-main-address input');
      if (addressInput) {
        addressInput.value = fullAddress;
        addressInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
    applyStages?.();
    if (Object.hasOwn(incident, 'dialogueCriteria')) form.dispatchEvent(new CustomEvent('apply-generated-criteria', { detail: incident.dialogueCriteria }));
  };

  prompt?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      chat.requestSubmit();
    }
  });

  chat?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const text = prompt.value.trim();
    if (!text || send.loading) return;
    send.loading = true;
    page.classList.add('generator-busy');
    generator.setAttribute('aria-busy', 'true');
    appendMessage('user', text);
    messages.push({ role: 'user', content: text });
    prompt.value = '';
    try {
      const response = await fetch('/api/v1/incidents/generate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ messages: messages.slice(-5), draft: collectDraft() }) });
      if (!response.ok) {
        const body = await response.json().catch(() => ({}));
        throw new Error(body.message || body.detail || 'Не удалось сгенерировать сценарий');
      }
      const result = await response.json();
      applyIncident(result.incident);
      const reply = result.message || 'Черновик обновлён.';
      messages.push({ role: 'assistant', content: reply });
      appendMessage('assistant', reply);
    } catch (caught) {
      appendMessage('error', caught instanceof Error ? caught.message : 'Ошибка генерации');
    } finally {
      send.loading = false;
      page.classList.remove('generator-busy');
      generator.removeAttribute('aria-busy');
    }
  });
</script>
<style is:global>
