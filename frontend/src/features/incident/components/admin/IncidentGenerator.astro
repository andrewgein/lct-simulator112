  wa-page.generator-open:has(#incident-generator) { --aside-width: var(--generator-panel-width); }
  wa-page.generator-open:has(#incident-generator)::part(aside) { opacity: 1; pointer-events: auto; border-inline-start: 1px solid var(--wa-color-surface-border); }
  .generator-thinking { position: fixed; z-index: 1050; inset-block-start: 50%; inset-inline-start: calc((100vw - var(--generator-panel-width)) / 2); width: 7rem; height: 7rem; border-radius: 50%; opacity: 0; visibility: hidden; pointer-events: none; transform: translate(-50%, -50%) scale(.72); transition: opacity var(--wa-transition-slow), transform var(--wa-transition-slow), visibility 0s linear var(--wa-transition-slow); }
  .generator-thinking::before { position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(circle, color-mix(in srgb, var(--wa-color-brand-fill-loud) 18%, transparent), transparent 68%); content: ''; filter: blur(.45rem); transform: scale(.7); transition: transform var(--wa-transition-slow); }
  body:has(wa-page.generator-busy) .generator-thinking { opacity: 1; visibility: visible; transform: translate(-50%, -50%) scale(1); transition-delay: 0s; }
  body:has(wa-page.generator-busy) .generator-thinking::before { transform: scale(1.35); }
  .generator-thinking-star { position: absolute; color: var(--wa-color-brand-fill-loud); filter: drop-shadow(0 0 .55rem color-mix(in srgb, var(--wa-color-brand-fill-loud) 55%, transparent)); animation-play-state: paused; }
  body:has(wa-page.generator-busy) .generator-thinking-star { animation-play-state: running; }
  .generator-thinking-star--one { inset-block-start: 50%; inset-inline-start: 50%; font-size: 2rem; animation: generator-star-orbit 2.4s linear infinite; }
  .generator-thinking-star--two { inset-block-start: 50%; inset-inline-start: 50%; font-size: 1.15rem; animation: generator-star-orbit 2.4s linear -.8s infinite; }
  .generator-thinking-star--three { inset-block-start: 50%; inset-inline-start: 50%; font-size: 1.45rem; animation: generator-star-orbit 2.4s linear -1.6s infinite; }
  @keyframes generator-star-orbit {
    0%, 100% { opacity: 1; transform: translate(-50%, -50%) translate3d(2.15rem, 1.5rem, 0) scale(1.15); }
    12.5% { opacity: .9; transform: translate(-50%, -50%) translate3d(1.05rem, 1.7rem, 0) scale(1.08); }
    25% { opacity: .75; transform: translate(-50%, -50%) translate3d(-.65rem, .9rem, 0) scale(.92); }
    37.5% { opacity: .5; transform: translate(-50%, -50%) translate3d(-1.95rem, -.4rem, 0) scale(.74); }
    50% { opacity: .3; transform: translate(-50%, -50%) translate3d(-2.15rem, -1.5rem, 0) scale(.58); }
    62.5% { opacity: .42; transform: translate(-50%, -50%) translate3d(-1.05rem, -1.7rem, 0) scale(.68); }
    75% { opacity: .62; transform: translate(-50%, -50%) translate3d(.65rem, -.9rem, 0) scale(.84); }
    87.5% { opacity: .85; transform: translate(-50%, -50%) translate3d(1.95rem, .4rem, 0) scale(1.04); }
  }
  button.generator-tab { position: fixed; z-index: 1100; inset-inline-end: 0; bottom: 4rem; display: flex; width: 4.25rem; height: 9rem; flex-direction: column; align-items: center; justify-content: center; gap: var(--wa-space-xs); padding: 0; border: 0; border-radius: 0; background: var(--wa-color-brand-fill-loud); color: var(--wa-color-brand-on-loud); box-shadow: -4px 4px 12px rgb(18 38 60 / 18%); cursor: pointer; transition: inset-inline-end var(--wa-transition-normal), filter var(--wa-transition-fast); }
  button.generator-tab[aria-expanded="true"] { inset-inline-end: var(--generator-panel-width); }
  .generator-tab-icon { display: block; width: 2.5rem; height: 2.5rem; flex: 0 0 2.5rem; margin-inline: auto; font-size: 2.25rem; line-height: 1; }
  .generator-tab-label { font-size: var(--wa-font-size-m); font-weight: var(--wa-font-weight-bold); letter-spacing: .08em; }
  .generator-tab-caption { margin-block-start: calc(-1 * var(--wa-space-xs)); font-size: var(--wa-font-size-xs); font-weight: var(--wa-font-weight-semibold); }
  button.generator-tab:hover, button.generator-tab:focus-visible { filter: brightness(.88); }
  button.generator-tab:focus-visible { outline: var(--wa-focus-ring); outline-offset: calc(-1 * var(--wa-focus-ring-offset)); }
  #incident-generator { display: flex; position: relative; flex: none; flex-direction: column; box-sizing: border-box; width: var(--generator-panel-width); height: calc(100dvh - var(--banner-height) - var(--header-height) - var(--subheader-height)); min-height: 0; padding: var(--wa-space-m); transition: box-shadow var(--wa-transition-slow); }
  wa-page.generator-busy #incident-generator { animation: generator-focus 1.6s ease-in-out infinite alternate; }
  @keyframes generator-focus {
    from { box-shadow: calc(-1 * var(--wa-space-l)) 0 2rem color-mix(in srgb, var(--wa-color-brand-fill-loud) 8%, transparent); }
    to { box-shadow: calc(-1 * var(--wa-space-xl)) 0 3rem color-mix(in srgb, var(--wa-color-brand-fill-loud) 22%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    wa-page:has(#incident-generator)::part(main), wa-page:has(#incident-generator)::part(menu), wa-page:has(#incident-generator)::part(subheader), wa-page:has(#incident-generator)::part(footer), #incident-generator { transition: none; }
    wa-page.generator-busy #incident-generator { animation: none; box-shadow: calc(-1 * var(--wa-space-l)) 0 2rem color-mix(in srgb, var(--wa-color-brand-fill-loud) 14%, transparent); }
  }
  .generator-heading { display: flex; align-items: center; justify-content: space-between; padding-block-end: var(--wa-space-m); border-block-end: var(--wa-border-width-s) solid var(--wa-color-surface-border); }
  .generator-title { display: flex; align-items: center; gap: var(--wa-space-s); }
  .generator-title wa-icon { color: var(--wa-color-brand-fill-loud); font-size: var(--wa-font-size-xl); }
  .generator-heading h2 { margin: 0; font-size: var(--wa-font-size-l); }
  @media (max-width: 60rem) {
    :root { --generator-panel-width: calc(100vw - 4.25rem); }
    wa-page.generator-open:has(#incident-generator) { --aside-width: var(--generator-panel-width); }
    wa-page.generator-open:has(#incident-generator)::part(main) { overflow: hidden; }
    .generator-thinking { display: none; }
  }
  .generator-body { display: flex; flex: 1; flex-direction: column; gap: var(--wa-space-m); min-height: 0; padding-block-start: var(--wa-space-m); }
  #generator-messages { display: flex; flex: 1; flex-direction: column; gap: var(--wa-space-s); min-height: 8rem; overflow-y: auto; }
  .generator-message { max-width: 90%; margin: 0; padding: var(--wa-space-s); border: var(--wa-border-width-s) solid var(--wa-color-surface-border); border-radius: 0; overflow-wrap: anywhere; white-space: pre-wrap; background: var(--wa-color-surface-lowered); }
  .generator-message--user { align-self: flex-end; border-color: var(--wa-color-brand-border-loud); background: var(--wa-color-brand-fill-loud); color: var(--wa-color-brand-on-loud); }
  .generator-message--error { border-color: var(--wa-color-danger-border-quiet); background: var(--wa-color-danger-fill-quiet); color: var(--wa-color-danger-60); }
  .generator-compose { display: flex; align-items: flex-end; gap: var(--wa-space-s); padding-block-start: var(--wa-space-m); border-block-start: var(--wa-border-width-s) solid var(--wa-color-surface-border); }
  .generator-compose wa-textarea { flex: 1; min-width: 0; }
  .generator-compose wa-button { flex: none; }
  #generator-prompt::part(textarea-wrapper), #generator-send::part(button) { border-radius: 0; }
</style>
