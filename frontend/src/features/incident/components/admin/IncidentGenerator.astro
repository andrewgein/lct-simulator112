  wa-page:has(#incident-generator) { --aside-width: 0px; }
  wa-page:has(#incident-generator)::part(body) { transition: grid-template-columns var(--wa-transition-normal); }
  wa-page:has(#incident-generator)::part(main), wa-page:has(#incident-generator)::part(menu), wa-page:has(#incident-generator)::part(subheader), wa-page:has(#incident-generator)::part(footer) { transition: filter var(--wa-transition-slow), opacity var(--wa-transition-slow); }
  wa-page.generator-busy:has(#incident-generator)::part(main), wa-page.generator-busy:has(#incident-generator)::part(menu), wa-page.generator-busy:has(#incident-generator)::part(subheader), wa-page.generator-busy:has(#incident-generator)::part(footer) { filter: blur(.4rem) saturate(.65); opacity: .48; pointer-events: none; user-select: none; }
