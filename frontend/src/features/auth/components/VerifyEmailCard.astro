---
import { verifyEmail } from '../api/AuthApi.js';
export const prerender = false;

let status = "pending";
let message = "";
let token = Astro.url.searchParams.get("token");

if (!token) {
  status = "error";
  message = "Недействительная ссылка";
} else {
  const verificationResponse = await verifyEmail(token);
  if (!verificationResponse.ok) {
    status = "error";
    message = "Не удалось подтвердить email";
  } else {
    const verificationData = await verificationResponse.json();
    message = verificationData.message;
    if (verificationData.status != 200) {
      status = "error";
    } else {
      status = "success";
    }
  }
}
---
<section class="login-card" aria-labelledby="login-title">
  <div class="login-heading" id="login-title">
    <span class="login-number">112</span>
    <span class="login-title">Подтверждение почты</span>
  </div>
  <div class="login-body">
    {status == "success" && (
      <>
        <p class="login-message login-success" role="status">{message}</p>
        <a class="login-primary" href="/login">Войти</a>
      </>
    )}
    {status == "error" && (
      <>
        <p class="login-message login-error" role="alert">{message}</p>
        <a class="login-primary" href="/register">Регистрация</a>
        <a class="login-secondary" href="/login">Войти</a>
      </>
    )}
  </div>
</section>
