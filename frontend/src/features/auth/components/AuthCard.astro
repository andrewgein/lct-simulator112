---
interface Props {
  title: string;
  action: string;
  emailLabel: string;
  passwordAutocomplete: "current-password" | "new-password";
  submitLabel: string;
  alternateHref: string;
  alternateLabel: string;
  error?: string | null;
  success?: string | null;
}

const {
  title,
  action,
  emailLabel,
  passwordAutocomplete,
  submitLabel,
  alternateHref,
  alternateLabel,
  error = null,
  success = null,
} = Astro.props;
---
<section class="login-card" aria-labelledby="login-title">
  <div class="login-heading" id="login-title">
    <span class="login-number">112</span>
    <span class="login-title">{title}</span>
  </div>
  <form method="POST" action={action}>
    <label class="login-field">
      <span>{emailLabel}</span>
      <input type="email" name="email" autocomplete="username" required>
    </label>
    <label class="login-field">
      <span>ПАРОЛЬ:</span>
      <input type="password" name="password" autocomplete={passwordAutocomplete} required>
    </label>
    <button type="submit" class="login-primary">{submitLabel}</button>
    <a class="login-secondary" href={alternateHref}>{alternateLabel}</a>
    {success && <p class="login-message login-success" role="status">{success}</p>}
    {error && <p class="login-message login-error" role="alert">{error}</p>}
  </form>
</section>
