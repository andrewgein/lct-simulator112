---
interface Props {
  title: string;
  action: string;
  emailLabel: string;
  passwordAutocomplete: "current-password" | "new-password";
  submitLabel: string;
  alternateHref: string;
  alternateLabel: string;
  error?: string | null;
  success?: string | null;
}

const {
  title,
  action,
  emailLabel,
  passwordAutocomplete,
  submitLabel,
  alternateHref,
  alternateLabel,
  error = null,
  success = null,
} = Astro.props;
---
<section class="login-card" aria-labelledby="login-title">
  <div class="login-heading" id="login-title">
    <span class="login-number">112</span>
    <span class="login-title">{title}</span>
  </div>
  <form method="POST" action={action}>
    <label class="login-field">
      <span>{emailLabel}</span>
      <input type="email" name="email" autocomplete="username" required>
    </label>
    <label class="login-field">
      <span>ПАРОЛЬ:</span>
      <input type="password" name="password" autocomplete={passwordAutocomplete} required>
    </label>
    <button type="submit" class="login-primary">{submitLabel}</button>
    <a class="login-secondary" href={alternateHref}>{alternateLabel}</a>
    {success && <p class="login-message login-success" role="status">{success}</p>}
    {error && <p class="login-message login-error" role="alert">{error}</p>}
  </form>
</section>

<style is:global>
  .login-card {
    position: absolute;
    z-index: 2;
    top: 11.5%;
    right: 5.8%;
    width: 29.2vw;
    color: #f8fbfb;
  }

  .login-card .login-heading {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.25vw, 1.6rem);
  }

  .login-card .login-number {
    font-size: clamp(4.5rem, 5.5vw, 7rem);
    font-weight: 300;
    line-height: 0.82;
    letter-spacing: 0.015em;
  }

  .login-card .login-title {
    flex: 1 1 0;
    min-width: 0;
    font-size: clamp(1.25rem, 1.55vw, 2rem);
    font-weight: 300;
    line-height: 1.12;
  }

  .login-card form {
    margin-top: clamp(2rem, 5.5vh, 3.5rem);
  }

  .login-card .login-field {
    display: block;
    margin-bottom: clamp(1rem, 2vh, 1.5rem);
    color: #2f6fa8;
    font-size: clamp(0.85rem, 0.95vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .login-card .login-field span {
    display: block;
    margin-bottom: 0.35rem;
  }

  .login-card .login-field input {
    box-sizing: border-box;
    width: 100%;
    height: clamp(2.75rem, 5vh, 3.25rem);
    padding: 0 0.6rem;
    border: 0;
    border-bottom: 2px solid rgba(207, 245, 249, 0.85);
    border-radius: 0;
    outline: 0;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    font: inherit;
    font-size: clamp(1.1rem, 1.3vw, 1.4rem);
    font-weight: 400;
    letter-spacing: normal;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .login-card .login-field input:focus {
    border-bottom-color: #ffffff;
    background: rgba(255, 255, 255, 0.2);
  }

  .login-card .login-field input:-webkit-autofill {
    -webkit-text-fill-color: #ffffff;
    transition: background-color 9999s ease-in-out 0s;
  }

  .login-card .login-primary,
  .login-card .login-secondary {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    width: 100%;
    min-height: clamp(3rem, 5.4vh, 3.6rem);
    border: 0;
    font: inherit;
    font-size: clamp(1rem, 1.15vw, 1.35rem);
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .login-card .login-primary {
    margin-top: clamp(0.75rem, 1.8vh, 1.1rem);
    background: #808080;
    color: #ffffff;
  }

  .login-card .login-primary:hover {
    background: #737373;
  }

  .login-card .login-primary:active {
    background: #666666;
  }

  .login-card .login-secondary {
    margin-top: 0.75rem;
    background: #ffffff;
    color: #4c5d65;
  }

  .login-card .login-secondary:hover {
    background: #eef3f5;
  }

  .login-card .login-secondary:active {
    background: #dde5e8;
  }

  .login-card .login-primary:focus-visible,
  .login-card .login-secondary:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  .login-card .login-message {
    margin: 1rem 0 0;
    padding: 0.75rem 0.9rem;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .login-card .login-error {
    background: rgba(120, 29, 29, 0.78);
  }

  .login-card .login-success {
    background: rgba(31, 100, 62, 0.82);
  }

  @media (max-width: 900px) {
    .login-card {
      top: 9%;
      right: 7vw;
      width: min(86vw, 32rem);
    }

    .login-card .login-title {
      max-width: 17rem;
    }
  }

  @media (max-width: 560px) {
    .login-card {
      top: 8%;
      right: 6vw;
      left: 6vw;
      width: auto;
    }

    .login-card .login-number {
      font-size: clamp(4rem, 19vw, 6rem);
    }

    .login-card .login-title {
      font-size: clamp(1.2rem, 6vw, 1.7rem);
    }

    .login-card form {
      margin-top: 2.25rem;
    }
  }

  @media (max-height: 700px) and (min-width: 700px) {
    .login-card {
      top: 5%;
    }

    .login-card form {
      margin-top: 1.25rem;
    }

    .login-card .login-field {
      margin-bottom: 0.75rem;
    }
  }
</style>
