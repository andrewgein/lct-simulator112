<wa-button id="logout-button" type="button" appearance="plain" variant="danger">
  <wa-icon slot="start" name="right-from-bracket">
  </wa-icon>
  Выйти
</wa-button>

<script>
  document.querySelector('#logout-button')?.addEventListener('click', async (event) => {
    const button = event.currentTarget;
    button.loading = true;
    try {
      const response = await fetch('/api/v1/auth/logout', { method: 'POST' });
      window.location.href = response.redirected ? response.url : '/login';
    } catch {
      button.loading = false;
      alert('Не удалось выйти. Попробуйте ещё раз.');
    }
  });
</script>
