---
import AuthCard from "./AuthCard.astro";
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.has("success")
  ? "Мы направили письмо на указанную почту. Для завершения регистрации необходимо перейти по ссылке из письма"
  : null;
---
<AuthCard
  title="Регистрация в учебном симуляторе"
  action="/api/v1/auth/register"
  emailLabel="ПОЧТА:"
  passwordAutocomplete="new-password"
  submitLabel="Зарегистрироваться"
  alternateHref="/login"
  alternateLabel="Войти"
  error={error}
  success={success}
/>
