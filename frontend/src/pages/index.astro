---
import Page from "../layouts/Page.astro";
import Header from "../layouts/Header.astro";
import MainHeader from "../layouts/MainHeader.astro";
import { getMyEnrollments } from "../features/course/api/EnrollmentApi";
import { getCourse } from "../features/course/api/CourseApi";
import { getUserReviews } from "../features/review/api/ReviewApi";

export const prerender = false;
if (["ADMIN", "SUPERVISOR"].includes(Astro.cookies.get("role")?.value || "")) return Astro.redirect("/teacher/courses");
let courses = [];
let error = null;
try {
  const [response, reviewsResponse] = await Promise.all([
    getMyEnrollments(Astro.locals.accessToken), getUserReviews(Astro.locals.accessToken)
  ]);
  if (!response.ok || !reviewsResponse.ok) throw new Error();
  const enrollments = await response.json();
  const reviews = (await reviewsResponse.json()).reviews || [];
  const completed = new Set(reviews.filter((review) => review.status === "DONE" && review.passed === true).map((review) => String(review.assignmentId)));
  courses = (await Promise.all(enrollments.map(async (enrollment) => {
    const courseResponse = await getCourse(enrollment.courseId, Astro.locals.accessToken);
    if (!courseResponse.ok) return null;
    const course = await courseResponse.json();
    const assignments = course.assignments || [];
    const done = assignments.filter((assignment) => completed.has(String(assignment.id))).length;
    return { course, done, total: assignments.length };
  }))).filter(Boolean);
} catch {
  error = "Не удалось загрузить назначенные курсы";
}
---
<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Мои курсы" />
  {!error && !courses.length && <wa-callout>Вам пока не назначено ни одного курса.</wa-callout>}
  <div class="course-list wa-stack wa-gap-s">
    {courses.map(({ course, done, total }) => {
      const progress = total ? Math.round(done / total * 100) : 0;
      return (
        <a class="course-row" href={`/courses/${course.id}`}>
          <h2>{course.title}</h2>
          <div class="course-progress wa-stack wa-gap-2xs">
            <span class="wa-caption-s wa-text-end">{done} из {total}</span>
            <wa-progress-bar value={progress} label={`Прогресс курса «${course.title}»: ${progress}%`}></wa-progress-bar>
          </div>
          <wa-icon class="wa-color-text-quiet" name="chevron-right"></wa-icon>
        </a>
      );
    })}
  </div>
</Page>
<style>
  .course-list { width: 100%; }
  .course-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(10rem, 16rem) auto; align-items: center; gap: var(--wa-space-l); padding: var(--wa-space-l); border: var(--wa-border-width-s) solid var(--wa-color-surface-border); background: var(--wa-color-surface-raised); color: var(--wa-color-text-normal); text-decoration: none; }
  .course-row:hover { border-color: var(--wa-color-brand-border-loud); background: var(--wa-color-brand-fill-quiet); }
  .course-row:focus-visible { outline: var(--wa-focus-ring-width) var(--wa-focus-ring-style) var(--wa-color-focus); outline-offset: var(--wa-focus-ring-offset); }
  .course-row h2 { margin: 0; font-size: var(--wa-font-size-l); }
  .course-progress wa-progress-bar { --track-height: var(--wa-space-2xs); }
  @media (max-width: 40rem) {
    .course-row { grid-template-columns: minmax(0, 1fr) auto; gap: var(--wa-space-m); padding: var(--wa-space-m); }
    .course-progress { grid-column: 1 / -1; grid-row: 2; }
    .course-progress span { text-align: start; }
  }
</style>
