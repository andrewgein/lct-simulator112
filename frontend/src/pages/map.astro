---
import { Leaflet } from "astro-leaflet";
import Page from "../layouts/Page.astro";
export const prerender = false;
---

<Page>
  <Leaflet
    id="location-map"
    options={{
      mapOptions: {
        attributionControl: false,
      },
      center: [55.7521, 37.6177], // Example coordinates
      zoom: 12,
    }}
  />
</Page>

<script>
  import { getMapFromId } from "astro-leaflet";
  import L from "astro-leaflet/leaflet";

  document.addEventListener("DOMContentLoaded", () => {
    const urlParams = new URLSearchParams(window.location.search);
    const targetInputId = urlParams.get("target");
    const address = urlParams.get("address");
    const latitude = Number(urlParams.get("lat"));
    const longitude = Number(urlParams.get("lng"));

    const map = getMapFromId("location-map");

    if (map) {
      let currentMarker = null;

      if (address && Number.isFinite(latitude) && Number.isFinite(longitude) && latitude && longitude) {
        currentMarker = L.marker([latitude, longitude]).addTo(map).bindPopup(address).openPopup();
        map.setView([latitude, longitude], 17);
      } else if (address) {
        fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&accept-language=ru&q=${encodeURIComponent(address)}`)
          .then((response) => response.json())
          .then((results) => {
            if (!results.length) return;
            const lat = Number(results[0].lat);
            const lng = Number(results[0].lon);
            currentMarker = L.marker([lat, lng]).addTo(map).bindPopup(address).openPopup();
            map.setView([lat, lng], 17);
          })
          .catch((error) => console.error("Address geocoding failed:", error));
      }

      map.on("click", async (e) => {
        const { lat, lng } = e.latlng;

        if (currentMarker) {
          currentMarker.setLatLng([lat, lng]);
        } else {
          currentMarker = L.marker([lat, lng]).addTo(map);
        }

        try {
          const response = await fetch(
            `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=ru`,
          );
          const data = await response.json();

          if (data && data.display_name) {
            const address = data.display_name;

            if (window.opener && !window.opener.closed) {
              window.opener.postMessage(
                { type: "LOCATION_PICKED", address, lat, lng, targetInputId },
                window.location.origin
              );
            }
          } else {
            console.log("Address not found for this location.");
          }
        } catch (error) {
          console.error("Reverse geocoding failed:", error);
        }
      });
    }
  });
</script>

<style>
  :global(main) {
    padding: 0rem;
  }
</style>
