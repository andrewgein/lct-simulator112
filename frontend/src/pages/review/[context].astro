---
import Page from "../../layouts/Page.astro";
import { getReview, getReviewComments, getReviewRecordings } from "../../features/review/api/ReviewApi";
import Header from "../../layouts/Header.astro";
import MainHeader from "../../layouts/MainHeader.astro";
import ReviewIncidentsPanel from "../../features/review/components/ReviewIncidentsPanel.jsx";

const accessToken = Astro.cookies.get("accessToken").value;
const role = Astro.cookies.get("role")?.value || "";
const isTeacher = ["ADMIN", "SUPERVISOR"].includes(role);
const canComment = isTeacher;
const canEditScores = isTeacher;
const { context } = Astro.params;
const [reviewResponse, commentsResponse, recordingsResponse] = await Promise.all([
  getReview(context, accessToken),
  getReviewComments(context, accessToken),
  getReviewRecordings(context, accessToken)
]);
const review = await reviewResponse.json();
const comments = commentsResponse.ok ? (await commentsResponse.json()).comments || [] : [];
const recordings = recordingsResponse.ok ? (await recordingsResponse.json()).recordings || [] : [];
const commentError = Astro.url.searchParams.get("commentError");
const commentAdded = Astro.url.searchParams.has("commentAdded");
const scoresError = Astro.url.searchParams.get("scoresError");
const scoresUpdated = Astro.url.searchParams.has("scoresUpdated");
const commentDateFormatter = new Intl.DateTimeFormat("ru-RU", { dateStyle: "medium", timeStyle: "short" });

const groupedIncidents = review.criterionResults.reduce((acc, current) => {
  const key = current.incidentId ? `incident:${current.incidentId}` : `legacy:${current.criterionName}`;
  if (!acc[key]) {
    acc[key] = {
      label: current.incidentOrder ? `Сценарий ${current.incidentOrder}` : current.criterionName,
      criteria: {},
    };
  }
  if (!acc[key].criteria[current.criterionName]) {
    acc[key].criteria[current.criterionName] = [];
  }
  acc[key].criteria[current.criterionName].push(current);
  return acc;
}, {});

const criteriaScore = review.criterionResults.reduce((sum, criterion) => sum + criterion.score, 0);
const criteriaMaxScore = review.criterionResults.reduce((sum, criterion) => sum + criterion.maxScore, 0);
const totalScore = review.finalScore ?? criteriaScore;
const maxTotalScore = review.maxScore ?? criteriaMaxScore;
const percentage = maxTotalScore > 0 ? Math.round((totalScore / maxTotalScore) * 100) : 0;

export const prerender = false;
---

<Page>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Результат">
    {isTeacher && <wa-button href="/teacher/courses" appearance="outlined"><wa-icon slot="start" name="arrow-left"></wa-icon>К курсам</wa-button>}
  </MainHeader>
  <div class="review-sections wa-stack wa-gap-2xl">
    <section class="wa-stack wa-gap-l" aria-labelledby="summary-heading">
      <h2 id="summary-heading" class="wa-heading-xl">Общая информация</h2>
      <wa-card appearance="filled-outlined">
        <div class="wa-stack wa-gap-l">
          {review.grade !== null && review.grade !== undefined && (
            <div class="wa-split wa-gap-s">
              <strong>Оценка:</strong>
              <span>{review.grade}</span>
            </div>
          )}
          <div class="wa-stack wa-gap-xs">
            <div class="wa-split wa-gap-s">
              <strong>Общий балл:</strong>
              <span>{totalScore} из {maxTotalScore} ({percentage}%)</span>
            </div>
            <wa-progress-bar value={percentage} label="Общий балл"></wa-progress-bar>
          </div>
          {review.grade !== null && review.grade !== undefined && (
            <wa-callout variant={review.passed ? "success" : "danger"}>{review.passed ? "Задание пройдено" : "Задание не пройдено"}</wa-callout>
          )}
          {!!review.incidents?.length && (
            <div class="wa-stack wa-gap-m">
              <strong>Инцидент:</strong>
              <ReviewIncidentsPanel contextId={context} incidents={review.incidents} cards={review.cards} canLinkToScenario={isTeacher} client:load />
            </div>
          )}
        </div>
      </wa-card>
    </section>
    <wa-divider></wa-divider>
    <section class="recordings-section wa-stack wa-gap-l" aria-labelledby="recordings-heading">
      <h2 id="recordings-heading" class="wa-heading-xl">Записи разговоров</h2>
      {recordings.length ? (
        <div class="recording-list wa-stack wa-gap-m">
          {recordings.map((recording, index) => (
            <article class="recording-entry">
              <strong>Разговор {index + 1}</strong>
              <audio controls preload="metadata" src={`/api/v1/review/${encodeURIComponent(context)}/recordings/${encodeURIComponent(recording.callId)}/${encodeURIComponent(recording.fileName)}`}>Ваш браузер не поддерживает воспроизведение аудио.</audio>
            </article>
          ))}
        </div>
      ) : (
        <div class="recordings-empty">Для этого уровня нет записей разговоров</div>
      )}
    </section>
    <wa-divider></wa-divider>
    <section class="wa-stack wa-gap-l" aria-labelledby="criteria-heading">
      <h2 id="criteria-heading" class="wa-heading-xl">Детализация по критериям</h2>
      {scoresUpdated && <wa-callout variant="success"><wa-icon slot="icon" name="circle-check"></wa-icon>Баллы обновлены</wa-callout>}
      {scoresError && <wa-callout variant="danger"><wa-icon slot="icon" name="circle-exclamation"></wa-icon>{scoresError}</wa-callout>}
      <form class="wa-stack wa-gap-l" method="POST" action={canEditScores ? `/api/v1/review/${encodeURIComponent(context)}/criteria` : undefined}>
      {Object.values(groupedIncidents).map((incident, incidentIndex) => {
        const items = Object.values(incident.criteria).flat();
        const incidentScore = items.reduce((sum, criterion) => sum + criterion.score, 0);
        const incidentMaxScore = items.reduce((sum, criterion) => sum + criterion.maxScore, 0);
        return (
          <>
            <wa-card appearance="filled-outlined">
              <div class="wa-stack">
                <strong class="wa-heading-m">{incident.label} {incidentScore} / {incidentMaxScore}</strong>
                {Object.entries(incident.criteria).map(([criterionName, criterionItems]) => {
                  const criterionScore = criterionItems.reduce((sum, criterion) => sum + criterion.score, 0);
                  const criterionMaxScore = criterionItems.reduce((sum, criterion) => sum + criterion.maxScore, 0);
                  return (
                    <wa-details>
                      <div slot="summary">
                        <span><strong>{criterionName}</strong> {criterionScore} / {criterionMaxScore}</span>
                      </div>
                      <ul>
                        {criterionItems.map((item) => (
                          <li>
                            {canEditScores ? (
                              <span class="criterion-item-editable">{item.feedback} <wa-input type="number" name={`score__${item.id}`} value={item.score} min="0" max={item.maxScore} size="small"></wa-input> / {item.maxScore}</span>
                            ) : (
                              <span>{item.feedback} {item.score}/{item.maxScore}</span>
                            )}
                          </li>
                        ))}
                      </ul>
                    </wa-details>
                  );
                })}
              </div>
            </wa-card>
            {incidentIndex < Object.keys(groupedIncidents).length - 1 && <wa-divider></wa-divider>}
          </>
        );
      })}
      {canEditScores && (
        <div class="criteria-form-actions">
          <wa-button type="submit" variant="brand">Сохранить оценки</wa-button>
        </div>
      )}
      </form>
    </section>
    <wa-divider></wa-divider>
    <section id="comments" class="comments-section wa-stack wa-gap-l" aria-labelledby="comments-heading">
      <div class="comments-heading">
        <h2 id="comments-heading" class="wa-heading-xl">Комментарии преподавателя</h2>
        {!!comments.length && <span class="wa-caption-m">{comments.length}</span>}
      </div>
      {commentAdded && <wa-callout variant="success"><wa-icon slot="icon" name="circle-check"></wa-icon>Комментарий добавлен</wa-callout>}
      {commentError && <wa-callout variant="danger"><wa-icon slot="icon" name="circle-exclamation"></wa-icon>{commentError}</wa-callout>}
      {!!comments.length ? (
        <div class="comment-list wa-stack wa-gap-m">
          {comments.map((comment) => (
            <article class="comment-entry">
              <header class="comment-entry-header">
                <strong>Преподаватель</strong>
                <time datetime={comment.createdAt}>{comment.createdAt ? commentDateFormatter.format(new Date(comment.createdAt)) : "Дата не указана"}</time>
              </header>
              <p>{comment.text}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="comments-empty">Комментариев пока нет</div>
      )}
      {canComment && (
        <form class="comment-form wa-stack wa-gap-m" method="POST" action={`/api/v1/review/${encodeURIComponent(context)}/comments`}>
          <wa-textarea name="text" label="Новый комментарий" rows="4" maxlength="4000" resize="vertical" required></wa-textarea>
          <div class="comment-form-actions">
            <wa-button type="submit" variant="brand">Добавить комментарий</wa-button>
          </div>
        </form>
      )}
    </section>
  </div>
</Page>

<style>
  .recording-entry {
    display: grid;
    grid-template-columns: minmax(8rem, auto) minmax(16rem, 1fr);
    align-items: center;
    gap: var(--wa-space-l);
    padding: var(--wa-space-m);
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    background: var(--wa-color-surface-raised);
  }

  .recording-entry audio {
    width: 100%;
  }

  .recordings-empty {
    padding: var(--wa-space-l);
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    color: var(--wa-color-text-quiet);
    background: var(--wa-color-surface-default);
  }

  .comments-heading {
    display: flex;
    align-items: baseline;
    gap: var(--wa-space-s);
  }

  .comments-heading h2 {
    margin: 0;
  }

  .comment-entry {
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    background: var(--wa-color-surface-raised);
  }

  .comment-entry-header {
    display: flex;
    justify-content: space-between;
    gap: var(--wa-space-m);
    padding: var(--wa-space-s) var(--wa-space-m);
    border-block-end: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    background: var(--wa-color-surface-default);
  }

  .comment-entry-header time {
    color: var(--wa-color-text-quiet);
    font-size: var(--wa-font-size-s);
  }

  .comment-entry p {
    margin: 0;
    padding: var(--wa-space-m);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .comments-empty {
    padding: var(--wa-space-l);
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    color: var(--wa-color-text-quiet);
    background: var(--wa-color-surface-default);
  }

  .comment-form {
    box-sizing: border-box;
    padding: var(--wa-space-l);
    border: var(--wa-border-width-s) solid var(--wa-color-surface-border);
    background: var(--wa-color-surface-raised);
  }

  .comment-form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .criterion-item-editable {
    display: inline-flex;
    align-items: center;
    gap: var(--wa-space-2xs);
  }

  .criterion-item-editable wa-input {
    width: 5rem;
  }

  .criteria-form-actions {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 600px) {
    .recording-entry {
      grid-template-columns: 1fr;
      gap: var(--wa-space-s);
    }

    .comment-entry-header {
      flex-direction: column;
      gap: var(--wa-space-2xs);
    }

    .comment-form {
      padding: var(--wa-space-m);
    }
  }
</style>
