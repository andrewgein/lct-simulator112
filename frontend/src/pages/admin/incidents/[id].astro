---
import Page from "../../../layouts/Page.astro";
import Header from "../../../layouts/Header.astro";
import MainHeader from "../../../layouts/MainHeader.astro";
import IncidentForm from "../../../features/incident/components/admin/IncidentForm.astro";
import IncidentGenerator from "../../../features/incident/components/admin/IncidentGenerator.astro";
import { getIncident } from "../../../features/incident/api/AdminIncidentApi";

export const prerender = false;
const role = Astro.cookies.get("role")?.value;
if (!["ADMIN", "SUPERVISOR"].includes(role || "")) return Astro.redirect("/");
let incident = null;
let error = null;
try {
  const response = await getIncident(Astro.params.id, Astro.locals.accessToken);
  if (!response.ok) {
    error = "Не удалось загрузить сценарии";
  } else {
    incident = await response.json();
  }
} catch (err) {
  error = "Не удалось загрузить сценарий";
  console.error(err);
}
---

<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Редактирование сценария">
    <div class="wa-cluster">
      <wa-button href="/admin/incidents" appearance="outlined" variant="neutral">Отмена</wa-button>
      <wa-button type="submit" form="incident-form" appearance="accent" variant="success">Сохранить</wa-button>
    </div>
  </MainHeader>
  {incident && <IncidentForm {incident} mode="edit" />}
  {incident && <div slot="aside"><IncidentGenerator /></div>}
  {incident && <div slot="floating" class="generator-thinking" aria-hidden="true"><wa-icon class="generator-thinking-star generator-thinking-star--one" name="star"></wa-icon><wa-icon class="generator-thinking-star generator-thinking-star--two" name="star"></wa-icon><wa-icon class="generator-thinking-star generator-thinking-star--three" name="star"></wa-icon></div>}
  {incident && <button slot="floating" id="open-incident-generator" class="generator-tab" type="button" aria-label="Открыть ИИ-чат" aria-controls="incident-generator" aria-expanded="false"><wa-icon class="generator-tab-icon" name="wand-magic-sparkles" aria-hidden="true"></wa-icon><span class="generator-tab-label">ИИ</span><span class="generator-tab-caption">помощник</span></button>}
</Page>
