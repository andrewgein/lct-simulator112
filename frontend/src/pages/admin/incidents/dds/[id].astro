---
import Page from "../../../../layouts/Page.astro";
import Header from "../../../../layouts/Header.astro";
import MainHeader from "../../../../layouts/MainHeader.astro";
import DdsIncidentForm from "../../../../features/incident/components/admin/dds/DdsIncidentForm.astro";
import { getIncident } from "../../../../features/incident/api/AdminIncidentApi.js";

export const prerender = false;
const role = Astro.cookies.get("role")?.value;
if (!["ADMIN", "SUPERVISOR"].includes(role || "")) return Astro.redirect("/");
let incident = null;
let error = null;
try {
  const response = await getIncident(Astro.params.id, Astro.locals.accessToken);
  if (!response.ok) error = "Не удалось загрузить сценарий ДДС";
  else {
    incident = await response.json();
    if (incident.targetType !== "DDS") return Astro.redirect(`/admin/incidents/${encodeURIComponent(Astro.params.id)}`);
  }
} catch (caught) {
  error = "Не удалось загрузить сценарий ДДС";
  console.error(caught);
}
---
<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Редактирование сценария ДДС">
    <div class="wa-cluster">
      <wa-button href="/admin/incidents" appearance="outlined" variant="neutral">Отмена</wa-button>
      <wa-button type="submit" form="dds-incident-form" appearance="accent" variant="success">Сохранить</wa-button>
    </div>
  </MainHeader>
  {incident && <DdsIncidentForm {incident} mode="edit" />}
</Page>
