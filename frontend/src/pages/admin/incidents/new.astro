---
import Page from "../../../layouts/Page.astro";
import Header from "../../../layouts/Header.astro";
import MainHeader from "../../../layouts/MainHeader.astro";
import IncidentForm from "../../../features/incident/components/admin/IncidentForm.astro";
import IncidentGenerator from "../../../features/incident/components/admin/IncidentGenerator.astro";

export const prerender = false;
const role = Astro.cookies.get("role")?.value;
if (!["ADMIN", "SUPERVISOR"].includes(role || "")) return Astro.redirect("/");
const type = Astro.url.searchParams.get("type") === "DDS" ? "DDS" : "SYSTEM_112";
---
<Page>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Новый сценарий">
    <div class="wa-cluster">
      <wa-button href="/admin/incidents" appearance="outlined" variant="neutral">Отмена</wa-button>
      <wa-button type="submit" form="incident-form" appearance="accent" variant="success">Сохранить</wa-button>
    </div>
  </MainHeader>
  <IncidentForm mode="create" {type} allowTypeSelection />
  {type === "SYSTEM_112" && <div slot="aside"><IncidentGenerator /></div>}
  {type === "SYSTEM_112" && <div slot="floating" class="generator-thinking" aria-hidden="true"><wa-icon class="generator-thinking-star generator-thinking-star--one" name="star"></wa-icon><wa-icon class="generator-thinking-star generator-thinking-star--two" name="star"></wa-icon><wa-icon class="generator-thinking-star generator-thinking-star--three" name="star"></wa-icon></div>}
  {type === "SYSTEM_112" && <button slot="floating" id="open-incident-generator" class="generator-tab" type="button" aria-label="Открыть ИИ-чат" aria-controls="incident-generator" aria-expanded="false"><wa-icon class="generator-tab-icon" name="wand-magic-sparkles" aria-hidden="true"></wa-icon><span class="generator-tab-label">ИИ</span><span class="generator-tab-caption">помощник</span></button>}
</Page>
