---
import Page from "../../../layouts/Page.astro";
import Header from "../../../layouts/Header.astro";
import MainHeader from "../../../layouts/MainHeader.astro";
import AdminLevelForm from "../../../features/level/components/admin/AdminLevelForm.astro";
import { getIncidentLibrary } from "../../../features/incident/api/AdminIncidentApi";

export const prerender = false;
if (Astro.cookies.get("role")?.value !== "ADMIN") return Astro.redirect("/");
let incidents = [];
let error = null;
try {
  incidents = await getIncidentLibrary(Astro.cookies.get("accessToken")?.value);
} catch {
  error = "Не удалось загрузить библиотеку происшествий";
}
---

<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Новый уровень">
    <div class="wa-cluster">
      <wa-button href="/admin/levels" appearance="outlined">Отмена</wa-button>
      <wa-button type="submit" form="level-form" variant="success">Сохранить</wa-button>
    </div>
  </MainHeader>
  {!error && (
    <AdminLevelForm {incidents} />
  )}
</Page>
