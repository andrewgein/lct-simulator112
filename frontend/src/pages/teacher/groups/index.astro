---
import Page from "../../../layouts/Page.astro";
import Header from "../../../layouts/Header.astro";
import MainHeader from "../../../layouts/MainHeader.astro";
import { getStudyGroupCourses, getStudyGroups } from "../../../features/course/api/CourseApi";
import { getStudents } from "../../../features/course/api/StudentApi";
import GroupCourseList from "../../../features/course/components/GroupCourseList.astro";

export const prerender = false;
if (!["ADMIN", "SUPERVISOR"].includes(Astro.cookies.get("role")?.value || "")) return Astro.redirect("/");
let groups = [];
let studentsById = new Map();
let assignedCoursesByGroupId = new Map();
let error = null;
try {
  const [response, students] = await Promise.all([
    getStudyGroups(Astro.locals.accessToken),
    getStudents(Astro.locals.accessToken)
  ]);
  if (!response.ok) throw new Error();
  groups = await response.json();
  const assignedCourseEntries = await Promise.all(groups.map(async (group) => {
    const assignedResponse = await getStudyGroupCourses(group.id, Astro.locals.accessToken);
    if (!assignedResponse.ok) throw new Error();
    return [String(group.id), await assignedResponse.json()];
  }));
  studentsById = new Map(students.map((student) => [String(student.id), student]));
  assignedCoursesByGroupId = new Map(assignedCourseEntries);
} catch {
  error = "Не удалось загрузить учебные группы";
}
---

<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Учебные группы">
    <wa-button href="/teacher/groups/new" variant="brand"><wa-icon slot="start" name="plus"></wa-icon>Новая группа</wa-button>
  </MainHeader>
  {!error && !groups.length && <wa-callout>Учебных групп пока нет. Создайте группу, чтобы назначать курсы нескольким обучающимся.</wa-callout>}
  {!error && groups.length > 0 && (
    <wa-accordion class="groups-accordion" appearance="outlined" heading-level="2" mode="single-collapsible">
      {groups.map((group, index) => {
        const students = (group.studentIds || []).map((id) => studentsById.get(String(id))).filter(Boolean);
        return (
          <wa-accordion-item expanded={index === 0}>
            <div slot="label" class="group-label wa-split wa-gap-m">
              <span class="wa-heading-l">{group.title}</span>
              <wa-badge variant="neutral" appearance="outlined">Участников: {students.length}</wa-badge>
            </div>
            <div class="group-content wa-stack wa-gap-l">
              <div class="wa-split wa-gap-m">
                <h3 class="group-section-title wa-heading-l">Состав группы</h3>
                <div class="wa-cluster wa-gap-xs">
                  <wa-button href={`/teacher/groups/${group.id}/statistics`} variant="brand" appearance="outlined"><wa-icon slot="start" name="chart-line"></wa-icon>Статистика</wa-button>
                  <wa-button href={`/teacher/groups/${group.id}`} appearance="outlined" aria-label={`Редактировать группу ${group.title}`}>
                    <wa-icon name="pen" label="Редактировать">
                    </wa-icon>
                  </wa-button>
                  <wa-button class="delete-group" type="button" appearance="outlined" variant="danger" data-id={group.id} data-title={group.title} aria-label={`Удалить группу ${group.title}`}>
                    <wa-icon name="trash" label="Удалить">
                    </wa-icon>
                  </wa-button>
                </div>
              </div>
              {students.length ? (
                <ul class="student-list wa-stack wa-gap-2xs">
                  {students.map((student) => {
                    const fullName = student.profile ? [student.profile.surname, student.profile.name, student.profile.patronymic].filter(Boolean).join(" ") : "Профиль не создан";
                    return (
                      <li class="student-row wa-split wa-gap-m">
                        <strong>{fullName}</strong>
                        <span>{student.email}</span>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <wa-callout variant="neutral">В группе пока нет обучающихся.</wa-callout>
              )}
              <GroupCourseList group={group} assignedCourses={assignedCoursesByGroupId.get(String(group.id)) || []} />
            </div>
          </wa-accordion-item>
        );
      })}
    </wa-accordion>
  )}
</Page>

<script>
  document.querySelectorAll('.delete-group').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!confirm(`Удалить группу «${button.dataset.title}» без возможности восстановления?`)) return;
      button.loading = true;
      const response = await fetch(`/api/v1/study-groups/${encodeURIComponent(button.dataset.id)}`, { method: 'DELETE' });
      if (response.ok) window.location.reload();
      else {
        button.loading = false;
        alert('Не удалось удалить группу');
      }
    });
  });
</script>

<style>
  .groups-accordion { width: 100%; }
  .groups-accordion wa-accordion-item::part(accordion-item),
  .groups-accordion wa-accordion-item::part(button),
  .groups-accordion wa-accordion-item::part(content) { background-color: var(--wa-color-surface-raised); }
  .group-label { width: 100%; align-items: center; font-weight: var(--wa-font-weight-semibold); }
  .group-content { padding-block: var(--wa-space-xs); }
  .group-section-title, .student-list { margin: 0; }
  .student-list { padding: 0; list-style: none; }
  .student-row { padding: var(--wa-space-s) var(--wa-space-m); border-block-end: var(--wa-border-width-s) solid var(--wa-color-surface-border); background: var(--wa-color-surface-raised); }
  .student-row:first-child { border-block-start: var(--wa-border-width-s) solid var(--wa-color-surface-border); }
  .student-row span { color: var(--wa-color-text-quiet); }
  @media (max-width: 48rem) {
    .group-content > .wa-split, .student-row { align-items: flex-start; flex-direction: column; }
    .group-label wa-badge { display: none; }
  }
</style>
