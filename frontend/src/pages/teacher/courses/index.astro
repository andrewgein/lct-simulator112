---
import Page from "../../../layouts/Page.astro";
import Header from "../../../layouts/Header.astro";
import MainHeader from "../../../layouts/MainHeader.astro";
import { getCourses } from "../../../features/course/api/CourseApi";

export const prerender = false;
if (!["ADMIN", "SUPERVISOR"].includes(Astro.cookies.get("role")?.value || "")) return Astro.redirect("/");
let courses = [];
let error = null;
try {
  const response = await getCourses(Astro.locals.accessToken);
  if (!response.ok) throw new Error();
  courses = await response.json();
} catch {
  error = "Не удалось загрузить курсы";
}
---

<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title="Курсы">
    <wa-button href="/teacher/courses/new" variant="brand"><wa-icon slot="start" name="plus"></wa-icon>Новый курс</wa-button>
  </MainHeader>
  {!error && !courses.length && <wa-callout>Курсов пока нет. Создайте программу из вводных материалов и практических заданий.</wa-callout>}
  {!error && courses.length > 0 && (
    <div class="course-list wa-stack wa-gap-m">
      {courses.map((course) => (
        <wa-card class="course-card" orientation="horizontal">
          <div class="course-summary wa-stack wa-gap-xs">
            <h2 class="wa-heading-l">{course.title}</h2>
            <p>{course.description || "Описание не добавлено"}</p>
          </div>
          <div slot="actions" class="course-actions wa-cluster wa-gap-xs">
            <wa-button href={`/teacher/courses/${course.id}`} appearance="outlined" aria-label={`Редактировать курс ${course.title}`}><wa-icon name="pen"></wa-icon></wa-button>
            <wa-button class="delete-course" type="button" appearance="outlined" variant="danger" data-id={course.id} data-title={course.title} aria-label={`Удалить курс ${course.title}`}><wa-icon name="trash"></wa-icon></wa-button>
          </div>
        </wa-card>
      ))}
    </div>
  )}
</Page>

<script>
  document.querySelectorAll('.delete-course').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!confirm(`Удалить курс «${button.dataset.title}» без возможности восстановления?`)) return;
      button.loading = true;
      const response = await fetch(`/api/v1/courses/${button.dataset.id}`, { method: 'DELETE' });
      if (response.ok) window.location.reload();
      else {
        button.loading = false;
        alert('Не удалось удалить курс');
      }
    });
  });
</script>

<style>
  .course-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
  .course-summary h2, .course-summary p { margin: 0; }
  .course-summary p { color: var(--wa-color-text-quiet); }
</style>
