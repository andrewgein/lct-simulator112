---
import Page from "../../../../layouts/Page.astro";
import Header from "../../../../layouts/Header.astro";
import MainHeader from "../../../../layouts/MainHeader.astro";
import { getCourses, getStudyGroups, getStudyGroupCourses } from "../../../../features/course/api/CourseApi";
import { getStudents } from "../../../../features/course/api/StudentApi";
import { getStudentReviews } from "../../../../features/review/api/ReviewApi";

export const prerender = false;
if (!["ADMIN", "SUPERVISOR"].includes(Astro.cookies.get("role")?.value || "")) return Astro.redirect("/");

const token = Astro.locals.accessToken;
let error = null;
let courseStats = [];

const scorePercent = (review) => {
  const criteria = review.criterionResults || [];
  const score = criteria.reduce((sum, criterion) => sum + criterion.score, 0);
  const maxScore = criteria.reduce((sum, criterion) => sum + criterion.maxScore, 0);
  return maxScore ? Math.round(score / maxScore * 100) : null;
};

try {
  const [coursesResponse, groupsResponse, students] = await Promise.all([
    getCourses(token),
    getStudyGroups(token),
    getStudents(token)
  ]);
  if (!coursesResponse.ok || !groupsResponse.ok) throw new Error();

  const courses = (await coursesResponse.json()).filter((course) => String(course.id) === String(Astro.params.id));
  if (!courses.length) return Astro.redirect('/teacher/courses');
  const groups = await groupsResponse.json();
  const groupCourses = await Promise.all(groups.map(async (group) => {
    const response = await getStudyGroupCourses(group.id, token);
    if (!response.ok) throw new Error();
    return { group, courses: await response.json() };
  }));
  const studentsById = new Map(students.map((student) => [String(student.id), student]));
  const courseStudents = new Map(courses.map((course) => [String(course.id), new Map()]));

  groupCourses.forEach(({ group, courses: assignedCourses }) => {
    assignedCourses.forEach((course) => {
      const entries = courseStudents.get(String(course.id));
      if (!entries) return;
      (group.studentIds || []).forEach((studentId) => {
        const key = String(studentId);
        const current = entries.get(key) || { student: studentsById.get(key), groups: [] };
        current.groups.push(group.title);
        entries.set(key, current);
      });
    });
  });

  const studentIds = [...new Set([...courseStudents.values()].flatMap((entries) => [...entries.keys()]))];
  const reviewResponses = await Promise.all(studentIds.map(async (studentId) => {
    const response = await getStudentReviews(studentId, token);
    if (!response.ok) throw new Error();
    return [studentId, (await response.json()).reviews || []];
  }));
  const reviewsByStudent = new Map(reviewResponses);

  courseStats = courses.map((course) => {
    const assignmentIds = new Set((course.assignments || []).map((assignment) => String(assignment.id)));
    const assignmentTitles = new Map((course.assignments || []).map((assignment) => [String(assignment.id), assignment.title]));
    const studentStats = [...(courseStudents.get(String(course.id)) || new Map()).values()].map(({ student, groups }) => {
      const attempts = (reviewsByStudent.get(String(student?.id)) || [])
        .filter((review) => assignmentIds.has(String(review.assignmentId)))
        .map((review) => ({ ...review, percent: scorePercent(review), assignmentTitle: assignmentTitles.get(String(review.assignmentId)) || "Задание" }))
        .sort((left, right) => new Date(right.createdAt || 0).getTime() - new Date(left.createdAt || 0).getTime());
      const completedByAssignment = new Map();
      attempts.filter((attempt) => attempt.status === "DONE").forEach((attempt) => {
        const key = String(attempt.assignmentId);
        if (!completedByAssignment.has(key)) completedByAssignment.set(key, attempt);
      });
      const completed = [...completedByAssignment.values()];
      const scored = completed.filter((review) => review.percent !== null);
      const average = scored.length ? Math.round(scored.reduce((sum, review) => sum + review.percent, 0) / scored.length) : null;
      const name = student?.profile ? [student.profile.surname, student.profile.name, student.profile.patronymic].filter(Boolean).join(" ") : student?.email || "Обучающийся";
      return { student, name, groups: [...new Set(groups)], attempts, completed: completed.length, average, lastActivity: attempts[0]?.createdAt || null };
    }).sort((left, right) => left.name.localeCompare(right.name, "ru"));
    const completed = studentStats.reduce((sum, student) => sum + student.completed, 0);
    const possible = studentStats.length * assignmentIds.size;
    const averages = studentStats.map((student) => student.average).filter((value) => value !== null);
    const average = averages.length ? Math.round(averages.reduce((sum, value) => sum + value, 0) / averages.length) : null;
    return { course, students: studentStats, completed, possible, average };
  });
} catch {
  error = "Не удалось загрузить статистику прохождений";
}

const allStudents = new Set(courseStats.flatMap(({ students }) => students.map(({ student }) => String(student?.id))));
const completedTotal = courseStats.reduce((sum, course) => sum + course.completed, 0);
const possibleTotal = courseStats.reduce((sum, course) => sum + course.possible, 0);
const allAverages = courseStats.map((course) => course.average).filter((value) => value !== null);
const averageTotal = allAverages.length ? Math.round(allAverages.reduce((sum, value) => sum + value, 0) / allAverages.length) : null;
const dateFormatter = new Intl.DateTimeFormat("ru-RU", { dateStyle: "medium", timeStyle: "short" });
---

<Page {error}>
  <Header slot="header" />
  <MainHeader slot="main-header" title={courseStats[0]?.course.title || "Статистика курса"}>
    <div class="wa-cluster wa-gap-xs">
      <wa-button href="/teacher/courses" appearance="outlined">Все курсы</wa-button>
      {courseStats[0] && <wa-button href={`/teacher/courses/${courseStats[0].course.id}`} appearance="outlined">Редактировать курс</wa-button>}
    </div>
  </MainHeader>
  {!error && (
    <div class="statistics-page wa-stack wa-gap-xl">
      <dl class="summary-strip">
        <div class="summary-item wa-stack wa-gap-2xs">
          <dt>Задания</dt>
          <dd>{courseStats[0]?.course.assignments?.length || 0}</dd>
        </div>
        <div class="summary-item wa-stack wa-gap-2xs">
          <dt>Обучающиеся</dt>
          <dd>{allStudents.size}</dd>
        </div>
        <div class="summary-item wa-stack wa-gap-2xs">
          <dt>Выполнено заданий</dt>
          <dd>{completedTotal} из {possibleTotal}</dd>
        </div>
        <div class="summary-item wa-stack wa-gap-2xs">
          <dt>Средний результат</dt>
          <dd>{averageTotal === null ? "—" : `${averageTotal}%`}</dd>
        </div>
      </dl>

      {!courseStats.length && <wa-callout>Статистика курса недоступна.</wa-callout>}
      {courseStats.map(({ course, students, completed, possible, average }) => {
        const progress = possible ? Math.round(completed / possible * 100) : 0;
        return (
          <wa-details appearance="filled-outlined" open>
            <div slot="summary" class="course-heading wa-split wa-gap-m">
              <div class="wa-stack wa-gap-2xs">
                <h2 class="wa-heading-l">{course.title}</h2>
                <span class="wa-caption-m">{students.length} обучающихся · {course.assignments?.length || 0} заданий</span>
              </div>
              <div class="wa-cluster wa-gap-xs">
                <wa-badge variant={progress === 100 ? "success" : "brand"} appearance="filled-outlined">{progress}% выполнено</wa-badge>
                <wa-badge variant="neutral" appearance="outlined">Средний балл: {average === null ? "—" : `${average}%`}</wa-badge>
              </div>
            </div>
            {!students.length ? (
              <wa-callout variant="neutral">Курс пока не назначен группе с обучающимися.</wa-callout>
            ) : (
              <wa-scroller>
                <table class="statistics-table wa-zebra-rows wa-hover-rows wa-tabular-nums">
                  <thead>
                    <tr>
                      <th>Обучающийся</th>
                      <th>Группа</th>
                      <th>Прогресс</th>
                      <th>Средний балл</th>
                      <th>Последняя активность</th>
                      <th>Попытки</th>
                    </tr>
                  </thead>
                  <tbody>
                    {students.map((student) => {
                      const assignmentCount = course.assignments?.length || 0;
                      const studentProgress = assignmentCount ? Math.round(student.completed / assignmentCount * 100) : 0;
                      return (
                        <tr>
                          <td><strong>{student.name}</strong><small>{student.student?.email}</small></td>
                          <td>{student.groups.join(", ")}</td>
                          <td>
                            <div class="progress-cell wa-stack wa-gap-2xs">
                              <span>{student.completed} из {assignmentCount}</span>
                              <wa-progress-bar class="student-progress" value={studentProgress} label={`Прогресс ${student.name}: ${studentProgress}%`}></wa-progress-bar>
                            </div>
                          </td>
                          <td>{student.average === null ? "—" : `${student.average}%`}</td>
                          <td>{student.lastActivity ? dateFormatter.format(new Date(student.lastActivity)) : "Нет попыток"}</td>
                          <td>
                            {student.attempts.length ? (
                              <div class="attempt-links wa-stack wa-gap-2xs">
                                {student.attempts.map((attempt) => (
                                  <a href={`/review/${encodeURIComponent(attempt.contextId)}`}>{attempt.assignmentTitle}: {attempt.status === "DONE" && attempt.percent !== null ? `${attempt.percent}%` : "формируется"}</a>
                                ))}
                              </div>
                            ) : "—"}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </wa-scroller>
            )}
          </wa-details>
        );
      })}
    </div>
  )}
</Page>

<style>
  .statistics-page { min-width: 0; }
  .summary-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(18ch, 1fr)); margin: 0; border-block: var(--wa-border-width-s) solid var(--wa-color-surface-border); background: var(--wa-color-surface-raised); }
  .summary-item { padding: var(--wa-space-l); }
  .summary-item + .summary-item { border-inline-start: var(--wa-border-width-s) solid var(--wa-color-surface-border); }
  .summary-item dt { color: var(--wa-color-text-quiet); }
  .summary-item dd { margin: 0; font-size: var(--wa-font-size-2xl); font-weight: var(--wa-font-weight-bold); line-height: 1; }
  .course-heading { width: 100%; }
  .course-heading h2 { margin: 0; }
  .statistics-table { min-width: 90ch; margin: 0; }
  .statistics-table td { vertical-align: top; }
  .statistics-table td:first-child small { display: block; color: var(--wa-color-text-quiet); }
  .progress-cell { min-width: 14ch; }
  .student-progress { --track-height: var(--wa-space-xs); }
  .attempt-links { min-width: 20ch; }
</style>
