---
import LevelApp from "../../../../features/level/components/player/LevelApp.jsx";
import DdsLevelApp from "../../../../features/level/components/player/DdsLevelApp.jsx";
import { getEnrollment } from "../../../../features/course/api/EnrollmentApi";
import { getCourse } from "../../../../features/course/api/CourseApi";
import { getUserReviews } from "../../../../features/review/api/ReviewApi";
import { getIncident, getIncidentClassifier } from "../../../../features/incident/api/IncidentApi";
import { normalizeClassifier } from "../../../../features/incident/storage/classifierHelpers";
import Page from "../../../../layouts/Page.astro";

export const prerender = false;
const { id: courseId, assignment: assignmentId } = Astro.params;
const contextId = Astro.url.searchParams.get("context");
const dialogEndpoint = import.meta.env.PUBLIC_DIALOG_ENDPOINT || "";
const dadataApiKey = import.meta.env.PUBLIC_DADATA_API_KEY || "";
const isDev = import.meta.env.DEV;
let targetType = null;
let incidents = [];
let classifier = [];
let routingFacts = [];
const profile = Astro.locals.profile;
let error = contextId ? null : "Не указан контекст прохождения задания";
if (!error) {
  try {
    const [enrollmentResponse, courseResponse, reviewsResponse] = await Promise.all([
      getEnrollment(courseId, Astro.locals.accessToken), getCourse(courseId, Astro.locals.accessToken),
      getUserReviews(Astro.locals.accessToken)
    ]);
    if (!enrollmentResponse.ok || !courseResponse.ok || !reviewsResponse.ok) throw new Error("Курс недоступен");
    const course = await courseResponse.json();
    const reviews = (await reviewsResponse.json()).reviews || [];
    const completed = new Set(reviews.filter((review) => review.status === "DONE").map((review) => review.assignmentId));
    const assignment = course.assignments.find((item) => item.id === assignmentId);
    const current = course.assignments.find((item) => !completed.has(item.id));
    if (!assignment || current?.id !== assignmentId) throw new Error("Задание недоступно");
    const responses = await Promise.all(assignment.incidentIds.map((incidentId) =>
      getIncident(incidentId, Astro.locals.accessToken)));
    if (responses.some((item) => !item.ok)) throw new Error("Не удалось загрузить сценарии");
    incidents = await Promise.all(responses.map((item) => item.json()));
    targetType = course.targetType;
    if (!targetType || incidents.some((item) => item.targetType !== targetType)) {
      throw new Error("Сценарии не соответствуют профилю курса");
    }
    if (targetType === "DDS") {
      const classifierResponse = await getIncidentClassifier(Astro.locals.accessToken);
      if (!classifierResponse.ok || !profile) throw new Error("Не удалось загрузить рабочее поле ДДС");
      const normalizedClassifier = normalizeClassifier(await classifierResponse.json());
      classifier = normalizedClassifier.classifier;
      routingFacts = normalizedClassifier.routingFacts;
    }
  } catch (requestError) {
    error = requestError.message || "Не удалось загрузить задание";
  }
}
---
<Page {error}>
  {!error && targetType === "SYSTEM_112" && <LevelApp {contextId} {dialogEndpoint} {dadataApiKey} {isDev} client:load />}
  {!error && targetType === "DDS" && <DdsLevelApp {contextId} {incidents} {classifier} {routingFacts} userService={profile?.ddsService} client:load />}
</Page>
<style is:global>
  wa-page:has(.level-app)::part(main-content) { padding: 0; background: #899ba4; }
  wa-page:has(.level-app) > main { padding: 0; }
  .level-app { min-height: 100dvh; background: #899ba4; }
  .level-command-bar { display: grid; grid-template-columns: minmax(28rem, 1fr) minmax(38rem, 0.9fr); min-height: 8.5rem; background: #f4f6f6; border-block-end: var(--wa-border-width-s) solid #71858f; }
  .level-search { justify-content: center; padding: var(--wa-space-l); }
  .level-search wa-input { width: 100%; --wa-form-control-border-color: #35434a; --wa-form-control-border-radius: 0; --wa-form-control-background-color: transparent; }
  .level-search wa-input::part(input-wrapper) { border-width: 0 0 var(--wa-border-width-s); }
  .level-search wa-input::part(input) { padding-inline: 0; font-size: var(--wa-font-size-2xl); }
  .level-operator-status { display: grid; grid-template-columns: minmax(12rem, 1fr) clamp(16rem, 27vw, 22rem) minmax(8rem, auto); min-width: 0; background: #293238; color: #ffffff; }
  .level-current-date, .level-connection, .level-operator-status > time { display: flex; padding: var(--wa-space-m); border-inline-start: var(--wa-border-width-s) solid #71858f; }
  .level-current-date { min-width: 0; }
  .level-current-date strong { overflow: hidden; text-overflow: ellipsis; text-transform: capitalize; white-space: nowrap; }
  .level-current-date span { color: #b8c6cc; font-size: var(--wa-font-size-s); }
  .level-connection { color: #b8c6cc; font-size: var(--wa-font-size-s); }
  .level-connection wa-icon { font-size: var(--wa-font-size-xl); }
  .level-operator-status time { align-items: center; justify-content: center; font-size: var(--wa-font-size-3xl); font-weight: var(--wa-font-weight-bold); font-variant-numeric: tabular-nums; }
  .level-operator-status time small { align-self: flex-start; margin-block-start: var(--wa-space-s); font-size: var(--wa-font-size-m); }
  .active-cards { padding: var(--wa-space-l); }
  .incident-list-heading { padding: var(--wa-space-m) var(--wa-space-l); color: #f4f6f6; }
  .incident-list-heading h2 { margin: 0; font-size: var(--wa-font-size-xl); }
  .incident-list-heading span { color: #d2dde1; font-size: var(--wa-font-size-s); }
  .cards-grid { background: #899ba4; border-color: #71858f; }
  .cards-table { min-width: 68rem; color: #edf2f3; --wa-color-fill-quiet: #52656e; --wa-color-border-quiet: #71858f; --wa-color-border-normal: #93a3aa; }
  .cards-table thead { background: #899ba4; color: #e5ecee; }
  .cards-table th { padding: var(--wa-space-s) var(--wa-space-m); border-block-end-color: #c3cdd1; font-weight: var(--wa-font-weight-semibold); white-space: nowrap; }
  .cards-table td { box-sizing: border-box; max-width: 24rem; padding: var(--wa-space-s) var(--wa-space-m); overflow: hidden; border-inline-end: var(--wa-border-width-s) solid #71858f; background: #2b363c; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; }
  .cards-table tbody tr { border-block-start: var(--wa-border-width-s) solid #71858f; }
  .cards-table tbody tr:nth-child(even) td { background: #455862; }
  .cards-table tbody tr:hover td, .cards-table tbody tr:focus-visible td { background: #526a75; }
  .cards-table tbody tr:focus-visible { outline: var(--wa-focus-ring-width) var(--wa-focus-ring-style) var(--wa-color-focus); outline-offset: calc(-1 * var(--wa-focus-ring-width)); }
  .cards-table .data-grid__heading:first-child, .cards-table .data-grid__cell--details { width: 3rem; padding-inline: var(--wa-space-xs); text-align: center; }
  .cards-table .data-grid__cell--relation { width: 7rem; color: #d9e4e8; }
  .card-relation-indent { display: inline-flex; align-items: center; gap: var(--wa-space-xs); padding-inline-start: calc(var(--card-depth) * var(--wa-space-l)); }
  .card-collapse, .card-details-toggle { --wa-color-neutral-on-quiet: #edf2f3; --wa-color-neutral-on-normal: #ffffff; }
  .cards-table .data-grid__cell--id { width: 9rem; color: #c7d5da; }
  .cards-table .data-grid__cell--incident { width: 25%; color: #ffffff; }
  .cards-table .data-grid__cell--applicant { width: 18%; }
  .cards-table .data-grid__cell--address { width: 27%; color: #e0e8ea; }
  .cards-table .data-grid__cell--kindLabel { width: 8rem; color: #c7d5da; }
  .cards-table .data-grid__cell--status { width: 10rem; color: #d8e5e9; }
  .is-complete .data-grid__cell--status wa-icon { color: #b8d5df; }
  .is-incomplete .data-grid__cell--status { color: #ffe7a6; }
  .cards-table .data-grid__expanded-row td { max-width: none; padding: 0; border-block-start: var(--wa-border-width-s) solid #71858f; background: #455862; white-space: normal; }
  .cards-table .data-grid__expanded-row:hover td { background: #455862; }
  .incident-row-details { display: grid; color: #eef3f4; }
  .incident-row-details > div { display: flex; align-items: baseline; gap: var(--wa-space-s); min-width: 0; padding: var(--wa-space-xs) var(--wa-space-m); border-block-end: var(--wa-border-width-s) solid #71858f; }
  .incident-row-details > div:last-child { border-block-end: 0; }
  .incident-row-details span { flex: 0 0 auto; color: #bdcbd0; }
  .incident-row-details strong { overflow-wrap: anywhere; }
  .incident-row-information strong { font-weight: var(--wa-font-weight-normal); }
  @media (max-width: 70rem) { .level-command-bar { grid-template-columns: 1fr; } .level-operator-status { min-height: 6rem; } }
  @media (max-width: 40rem) { .level-command-bar { min-height: auto; } .level-search { padding: var(--wa-space-m); } .level-search wa-input::part(input) { font-size: var(--wa-font-size-xl); } .level-operator-status { grid-template-columns: 1fr auto; } .level-current-date { display: none; } .active-cards { padding: var(--wa-space-xs); } .cards-grid { margin-inline: calc(-1 * var(--wa-space-xs)); } }

</style>
