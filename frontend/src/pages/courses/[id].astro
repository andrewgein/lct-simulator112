---
import Page from "../../layouts/Page.astro";
import Header from "../../layouts/Header.astro";
import MainHeader from "../../layouts/MainHeader.astro";
import { getCourse } from "../../features/course/api/CourseApi";
import { getEnrollment } from "../../features/course/api/EnrollmentApi";
import { getUserReviews } from "../../features/review/api/ReviewApi";
import { findActiveContext } from "../../features/context/api/ContextApi";

export const prerender = false;
let course;
let enrollment;
let reviews = [];
let error = null;
try {
  const [courseResponse, enrollmentResponse, reviewsResponse] = await Promise.all([
    getCourse(Astro.params.id, Astro.locals.accessToken),
    getEnrollment(Astro.params.id, Astro.locals.accessToken),
    getUserReviews(Astro.locals.accessToken)
  ]);
  if (!courseResponse.ok || !enrollmentResponse.ok || !reviewsResponse.ok) throw new Error();
  course = await courseResponse.json();
  enrollment = await enrollmentResponse.json();
  reviews = (await reviewsResponse.json()).reviews || [];
} catch {
  error = "Не удалось загрузить курс";
}

const materials = course?.materials || [];
const assignments = course?.assignments || [];
const finishedReviews = new Map();
reviews.filter((review) => review.status === "DONE").forEach((review) => {
  const assignmentId = String(review.assignmentId);
  const savedReview = finishedReviews.get(assignmentId);
  if (!savedReview || Date.parse(review.createdAt) > Date.parse(savedReview.createdAt)) finishedReviews.set(assignmentId, review);
});
const completed = new Set(reviews.filter((review) => review.status === "DONE" && review.passed === true).map((review) => String(review.assignmentId)));
const currentAssignment = assignments.find((assignment) => !completed.has(String(assignment.id)));
const requestedMaterial = Astro.url.searchParams.get("material");
const requestedAssignment = Astro.url.searchParams.get("assignment");
const materialKey = (material, index) => String(material.id ?? index);
const selectedAssignment = requestedAssignment ? assignments.find((assignment) => String(assignment.id) === requestedAssignment) : null;
const requestedMaterialIndex = requestedMaterial ? materials.findIndex((material, index) => materialKey(material, index) === requestedMaterial) : 0;
const selectedMaterial = !selectedAssignment ? materials[requestedMaterialIndex >= 0 ? requestedMaterialIndex : 0] : null;
const fallbackAssignment = !selectedMaterial && !selectedAssignment ? assignments[0] : null;
const activeAssignment = selectedAssignment || fallbackAssignment;
const selectedMaterialIndex = selectedMaterial ? materials.indexOf(selectedMaterial) : -1;
const contentType = selectedMaterial?.fileContentType?.toLowerCase() || "";
const fileName = selectedMaterial?.fileName?.toLowerCase() || "";
const isMarkdown = contentType.includes("markdown") || fileName.endsWith(".md");
const isPdf = contentType.includes("pdf") || fileName.endsWith(".pdf");
const isWord = contentType.includes("word") || fileName.endsWith(".doc") || fileName.endsWith(".docx");
const isExcel = contentType.includes("sheet") || contentType.includes("excel") || fileName.endsWith(".xls") || fileName.endsWith(".xlsx");
const activeAssignmentDone = activeAssignment ? completed.has(String(activeAssignment.id)) : false;
const activeAssignmentCurrent = activeAssignment && String(currentAssignment?.id) === String(activeAssignment.id);
const activeReview = activeAssignment ? finishedReviews.get(String(activeAssignment.id)) : null;
let activeContextId = null;
if (activeAssignmentCurrent) {
  try {
    const activeContextResponse = await findActiveContext(activeAssignment.id, Astro.locals.accessToken);
    if (activeContextResponse.status === 200) {
      activeContextId = JSON.parse(await activeContextResponse.text());
    }
  } catch {
    activeContextId = null;
  }
}
---
<Page {error}>
  <Header slot="header" />
  <MainHeader slot="subheader" title={course?.title || "Курс"}>
    <wa-button href="/" appearance="outlined"><wa-icon slot="start" name="arrow-left"></wa-icon>К курсам</wa-button>
  </MainHeader>
  {course && enrollment && (
    <wa-card slot="navigation" class="course-navigation-card" appearance="filled-outlined">
      <nav class="course-navigation wa-stack wa-gap-l" aria-label="Содержание курса">
        <section class="wa-stack wa-gap-xs" aria-labelledby="materials-menu-heading">
        <h2 id="materials-menu-heading">Вводные материалы</h2>
        {materials.length ? (
          <div class="wa-stack wa-gap-3xs">
            {materials.map((material, index) => {
              const active = index === selectedMaterialIndex;
              return <wa-button class="course-menu-button" href={`/courses/${course.id}?material=${encodeURIComponent(materialKey(material, index))}`} appearance={active ? "filled" : "plain"} variant={active ? "brand" : "neutral"} aria-current={active ? "page" : undefined} with-start><wa-icon slot="start" name={material.fileContentType?.toLowerCase().includes("pdf") ? "file-pdf" : "file-lines"}></wa-icon>{material.title || material.fileName}</wa-button>;
            })}
          </div>
        ) : <p class="menu-empty wa-caption-s">Материалы не добавлены</p>}
      </section>
      <wa-divider></wa-divider>
      <section class="wa-stack wa-gap-xs" aria-labelledby="assignments-menu-heading">
        <h2 id="assignments-menu-heading">Задания</h2>
        {assignments.length ? (
          <div class="wa-stack wa-gap-3xs">
            {assignments.map((assignment) => {
              const assignmentId = String(assignment.id);
              const done = completed.has(assignmentId);
              const failed = finishedReviews.get(assignmentId)?.passed === false;
              const current = String(currentAssignment?.id) === assignmentId;
              const active = String(activeAssignment?.id) === assignmentId;
              const locked = !done && !current;
              return <wa-button class="course-menu-button" href={`/courses/${course.id}?assignment=${encodeURIComponent(assignment.id)}`} appearance={active ? "filled" : "plain"} variant={active ? "brand" : "neutral"} aria-current={active ? "page" : undefined} with-start>{done ? <wa-icon slot="start" class="assignment-state-icon completed-icon" name="circle-check" label="Выполнено"></wa-icon> : failed ? <wa-icon slot="start" class="assignment-state-icon failed-icon" name="circle-xmark" label="Не пройдено"></wa-icon> : locked ? <wa-icon slot="start" class="assignment-state-icon" name="lock" label="Недоступно"></wa-icon> : <wa-icon slot="start" class="assignment-state-icon" name="circle" variant="regular" label="Не выполнено"></wa-icon>}{assignment.title}</wa-button>;
            })}
          </div>
        ) : <p class="menu-empty wa-caption-s">Задания не добавлены</p>}
        </section>
      </nav>
    </wa-card>
  )}
  {course && enrollment && (
    <section class="course-content" aria-live="polite">
      {selectedMaterial && (
        <div class="material-view wa-stack wa-gap-m">
          <div class="content-heading wa-stack wa-gap-m">
            <div class="wa-split wa-align-items-start wa-gap-m">
              <div class="wa-stack wa-gap-2xs">
                <span class="wa-caption-s">Вводный материал</span>
                <h2>{selectedMaterial.title || selectedMaterial.fileName}</h2>
              </div>
              {selectedMaterial.downloadUrl && <wa-button href={selectedMaterial.downloadUrl} download={selectedMaterial.fileName} appearance="outlined" with-start><wa-icon slot="start" name="download"></wa-icon>Скачать</wa-button>}
            </div>
            <wa-divider></wa-divider>
          </div>
          {isMarkdown && selectedMaterial.downloadUrl && <div id="markdown-viewer" class="document-viewer markdown-viewer wa-prose" data-source={selectedMaterial.downloadUrl}><p>Загрузка материала…</p></div>}
          {isPdf && selectedMaterial.downloadUrl && <iframe class="document-viewer pdf-viewer" src={selectedMaterial.downloadUrl} title={selectedMaterial.title || selectedMaterial.fileName}></iframe>}
          {isWord && selectedMaterial.downloadUrl && <div id="docx-viewer" class="document-viewer docx-viewer" data-source={selectedMaterial.downloadUrl}><p>Загрузка материала…</p></div>}
          {isExcel && selectedMaterial.downloadUrl && <div id="xlsx-viewer" class="document-viewer xlsx-viewer" data-source={selectedMaterial.downloadUrl}><p>Загрузка материала…</p></div>}
          {!selectedMaterial.downloadUrl && <wa-callout>Файл материала недоступен.</wa-callout>}
          {selectedMaterial.downloadUrl && !isMarkdown && !isPdf && !isWord && !isExcel && <wa-callout>Предпросмотр этого формата пока недоступен. <a href={selectedMaterial.downloadUrl} download>Скачать файл</a></wa-callout>}
        </div>
      )}
      {activeAssignment && (
        <div class="assignment-view wa-stack wa-gap-m">
          <div class="content-heading wa-stack wa-gap-m">
            <div class="wa-stack wa-gap-2xs">
              <span class="wa-caption-s">Задание</span>
              <h2>{activeAssignment.title}</h2>
            </div>
            <wa-divider></wa-divider>
          </div>
          <wa-card class="assignment-card" appearance="filled-outlined">
            <article class="assignment-body wa-stack wa-gap-l">
              <div class="assignment-description wa-prose">
                <p>{activeAssignment.description || "Описание задания не добавлено."}</p>
              </div>
              {!activeAssignmentCurrent && !activeAssignmentDone && <wa-callout><wa-icon slot="icon" name="lock"></wa-icon>Сначала выполните предыдущие задания.</wa-callout>}
            </article>
          </wa-card>
          {activeReview && <wa-callout variant={activeReview.passed ? "success" : "danger"}><wa-icon slot="icon" name={activeReview.passed ? "circle-check" : "circle-exclamation"}></wa-icon><div class="completion-summary wa-split wa-align-items-center"><strong>{activeReview.passed ? "Задание выполнено" : "Задание не пройдено"}</strong><a href={`/review/${encodeURIComponent(activeReview.contextId)}`}>Посмотреть детальный разбор <wa-icon name="arrow-right"></wa-icon></a></div></wa-callout>}
          {activeAssignmentCurrent && (
            <div class="assignment-actions wa-cluster wa-gap-s">
              {activeContextId && (
                <wa-button href={`/courses/${course.id}/assignments/${activeAssignment.id}?context=${activeContextId}`} variant="brand" size="large">Продолжить уровень</wa-button>
              )}
              <wa-button class="start-assignment" appearance={activeContextId ? "outlined" : "filled"} variant={activeContextId ? "neutral" : "brand"} size="large" data-course-id={course.id} data-assignment-id={activeAssignment.id}>{activeContextId ? "Начать заново" : "Начать"}</wa-button>
            </div>
          )}
        </div>
      )}
      {!selectedMaterial && !activeAssignment && <wa-callout>В курсе пока нет вводных материалов и заданий.</wa-callout>}
    </section>
  )}
</Page>
<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  const viewer = document.querySelector('#markdown-viewer');
  if (viewer) {
    fetch(viewer.dataset.source)
      .then((response) => {
        if (!response.ok) throw new Error();
        return response.text();
      })
      .then((markdown) => {
        viewer.innerHTML = DOMPurify.sanitize(marked.parse(markdown));
      })
      .catch(() => {
        viewer.innerHTML = '<p>Не удалось загрузить материал.</p>';
      });
  }

  const docxViewer = document.querySelector('#docx-viewer');
  if (docxViewer) {
    Promise.all([import('docx-preview'), fetch(docxViewer.dataset.source).then((response) => {
      if (!response.ok) throw new Error();
      return response.blob();
    })])
      .then(([docxPreview, blob]) => {
        docxViewer.innerHTML = '';
        return docxPreview.renderAsync(blob, docxViewer, docxViewer, { className: 'docx', inWrapper: true });
      })
      .catch(() => {
        docxViewer.innerHTML = '<p>Не удалось загрузить материал.</p>';
      });
  }

  const xlsxViewer = document.querySelector('#xlsx-viewer');
  if (xlsxViewer) {
    Promise.all([import('xlsx'), fetch(xlsxViewer.dataset.source).then((response) => {
      if (!response.ok) throw new Error();
      return response.arrayBuffer();
    })])
      .then(([XLSX, arrayBuffer]) => {
        const workbook = XLSX.read(arrayBuffer, { type: 'array' });
        xlsxViewer.innerHTML = DOMPurify.sanitize(workbook.SheetNames.map((sheetName) => `<h3>${sheetName}</h3>${XLSX.utils.sheet_to_html(workbook.Sheets[sheetName])}`).join(''));
      })
      .catch(() => {
        xlsxViewer.innerHTML = '<p>Не удалось загрузить материал.</p>';
      });
  }

  document.querySelectorAll('.start-assignment').forEach((button) => button.addEventListener('click', async () => {
    button.loading = true;
    try {
      const response = await fetch('/api/v1/context', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ assignmentId: button.dataset.assignmentId }) });
      if (!response.ok) {
        alert('Не удалось начать задание');
        return;
      }
      const { contextId } = await response.json();
      location.href = `/courses/${button.dataset.courseId}/assignments/${button.dataset.assignmentId}?context=${contextId}`;
    } catch {
      alert('Не удалось начать задание');
    } finally {
      button.loading = false;
    }
  }));
</script>
<style>
  .course-content { min-width: 0; }
  .course-navigation-card { width: 100%; --spacing: var(--wa-space-l); }
  .course-navigation h2 { margin: 0; font-size: var(--wa-font-size-m); }
  .course-menu-button { width: 100%; }
  .course-menu-button::part(button) { justify-content: flex-start; text-align: start; }
  .assignment-state-icon { font-size: var(--wa-font-size-l); }
  .completed-icon { color: var(--wa-color-success-fill-loud); }
  .failed-icon { color: var(--wa-color-danger-fill-loud); }
  .menu-empty { margin: 0; }
  .content-heading h2 { margin: 0; }
  .document-viewer { box-sizing: border-box; width: 100%; min-height: 65vh; border: var(--wa-border-width-s) solid var(--wa-color-surface-border); background: var(--wa-color-surface-raised); }
  .markdown-viewer { max-width: none; padding: var(--wa-space-xl); }
  .markdown-viewer > :first-child { margin-block-start: 0; }
  .markdown-viewer > :last-child { margin-block-end: 0; }
  .xlsx-viewer { padding: var(--wa-space-xl); overflow: auto; }
  .xlsx-viewer table { border-collapse: collapse; margin-block-end: var(--wa-space-l); }
  .xlsx-viewer td { border: var(--wa-border-width-s) solid var(--wa-color-surface-border); padding: var(--wa-space-3xs) var(--wa-space-xs); }
  .docx-viewer { overflow: auto; background: var(--wa-color-neutral-fill-loud, #52525b); padding: var(--wa-space-xl); }
  .docx-viewer :global(.docx-wrapper) { background: transparent; padding: 0; }
  .docx-viewer :global(.docx-wrapper > section.docx) { margin: 0 auto var(--wa-space-l); box-shadow: 0 2px 12px rgba(0, 0, 0, 0.25); overflow-x: auto; overflow-y: hidden; }
  .assignment-card { width: 100%; --spacing: var(--wa-space-xl); }
  .assignment-description p { margin-block-start: 0; white-space: pre-wrap; }
  .completion-summary { width: 100%; }
  .start-assignment { align-self: stretch; }
  .assignment-actions { align-self: stretch; }
  .assignment-actions wa-button { flex: 1 1 auto; }
</style>
