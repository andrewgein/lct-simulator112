# Copy to prod/.env and fill in. Used for the sim-112.ru / sim-112.online stack (the only
# environment - single-environment setup, deploys from main only).
COMPOSE_PROJECT_NAME=sim112-stable
DB_PASSWORD=change-me
FRONTEND_BASE_URL=https://sim-112.ru
DGIS_MAPGL_KEY=
PUBLIC_DADATA_API_KEY=change-me

# Where GitHub Actions pushed the built images, and which tag to run. The reusable workflow
# uses IMAGE_REGISTRY=ghcr.io/<repo-owner> and IMAGE_TAG=<branch>-<sha>. For a manual deploy
# without CD, build images locally under any registry/tag pair and set these to match -
# see prod/DEPLOY.md.
IMAGE_REGISTRY=ghcr.io/andrewgein/lct-simulator112
IMAGE_TAG=change-me

# dialog-service (runs in this stack, in Docker) talks to Qwen3-TTS - vosk/LLM don't need a
# GPU, but TTS does, so that one piece still lives on the home PC. Tailscale IP/hostname of
# that PC (tailscale ip -4 there).
TTS_SERVER_TAILSCALE_HOST=change-me

# dialog-service - shared with the LLM provider.
LLM_BASE_URL=https://api.aitunnel.ru/v1/
LLM_API_KEY=change-me
LLM_MODEL=gpt-oss-120b

OLLAMA_SERVER_TAILSCALE_HOST=change-me
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# notification-service - Gmail SMTP app password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=change-me@gmail.com
MAIL_PASSWORD=change-me

# Host port on the VM for context-service's gRPC - not needed by dialog-service anymore (same
# docker network now), kept for manual debugging.
CONTEXT_GRPC_HOST_PORT=9190

# minio / course-service - S3-compatible storage for course materials.
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# admin-service - daily DB backups uploaded to the "backups" MinIO bucket. The secrets/ dir
# (JWT keypair) is archived and encrypted with this passphrase (gpg --symmetric AES256) as part
# of the same run - keep it outside the repo, same as the other secrets here.
BACKUP_ENCRYPTION_KEY=change-me
BACKUP_RETENTION_DAYS=14

# admin-service - start/stop/restart/update a service from the admin panel by dispatching this
# repo's own GitHub Actions workflows (never touches docker.sock). Fine-grained PAT scoped to
# this repo only, with "Actions: Read and write" permission - create at
# https://github.com/settings/personal-access-tokens
GITHUB_REPOSITORY=andrewgein/lct-simulator112
GITHUB_ACTIONS_TOKEN=change-me


CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_REPLENISH=200
RATE_LIMIT_BURST=400
